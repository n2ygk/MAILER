SENDLST  TITLE 'CUCCA VM NETWORK MAILER VERSION 1 -  SEND LIST OF MAIL *
               RECIPIENTS'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
SENDLST CSECT ,
* SENDLST -
* This routine sends a list of recipients a mail file.
*
* E. Alan Crosswell                              CUCCA 4/82
*
* LAST EDIT: 4/23/82 BY ALAN CROSSWELL
*
*  CALLED VIA -
*  CALL SENDLST,(MAILBLOK)
         SPACE ,
PAB      DSECT ,
@MBLOK   DS    A             ADDRESS OF MAILBLOK
         SPACE ,
         SPACE
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 - MAILCHN POINTER
R9  EQU  9 - STACK POINTER
R10 EQU 10 - STACK LENGTH
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         BLOCKS ,
         MAILBLOK ,
         TRACETBL ,
         EJECT
SENDLST CSECT ,
         USING SENDLST,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'SENDLST',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING SENDLST,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         USING PAB,R1        ADDRESS PARM
         L     R11,@MBLOK    GET MAILBLOK BASE
         DROP  R1
         USING MAILBLOK,R11  ADDRESSABILITY
         LM    R9,R10,STACKP GET STACK POINTER
         SPACE ,
*--------------------------------------------------------------------
*  CHAIN DOWN LIST HUNG FROM MAILCHN
*  1) GET ACTADR
*  2) BUILD PLIST
*  3) CALL USER RTPROG
*--------------------------------------------------------------------
         XC    RETCODE,RETCODE  ZERO RETURN CODE
         TM    DBGFLG7,DBGSNDLS    Tracing?
         BNO   SNDDBG01            ---> No
         LINEDIT TEXT='SENDLST : **** Start processing of ACTADR chain X
               ****',DOT=NO
SNDDBG01 EQU   *
         LA    R7,MAILCHN
LOOP     EQU   *
         ICM   R8,B'1111',0(R7)        GET NEXT ACTADR BLOCK
         BZ    DONE          ALL DONE
         USING ACTADR,R8     ADDRESS IT
         LA    R7,ACTNEXT    POINT TO NEXT POINTER
         L     R5,ACTRT      POINT TO ROUTD
         USING ROUTD,R5      ADDRESS IT
         TM    DBGFLG7,DBGSNDLS    Tracing?
         BNO   SNDDBG10            ---> No
         LINEDIT TEXT='SENDLST : Destination ........@........ using ..X
               ...... exit (entry address = ........)',                X
               SUB=(CHARA,RTUSER,CHARA,RTROUTE,CHARA,RTPROG,HEX4A,RTADDX
               R),                                                     X
               DOT=NO,COMP=YES,RENT=NO
SNDDBG10 EQU   *
         LA    R1,RTPROG           Point to exit name
         MAILTRC CALL,(R1)         Create trace table entry
         ICM   R15,B'1111',RTADDR    ADDRESS OF ROUTING EXIT
         CALL  (15),((R11),(R8))     Call it
         LA    R1,RTPROG             Point to exit name
         MAILTRC RETURN,(R1),(R15)   Create trace table entry
         LTR   R15,R15       CHECK RETURN CODE
         BNZ   FAILED        EXIT FAILED
         L     R1,RTMSGCNT   GET MSG COUNTER
         LA    R1,1(R1)      BUMP IT
         ST    R1,RTMSGCNT   SET NEW COUNT
         LA    R1,MAILSFB    GET SFBLOK
         USING SFBLOK,R1     ADDRESS IT
         L     R1,SFBRECNO   NUMBER OF RECORDS
         DROP  R1
         C     R1,RTMSGMAX   COMPARE TO MAXIMUM
         BL    NOTMAX        NOT THE NEW MAX
         ST    R1,RTMSGMAX   SET NEW MAX
NOTMAX   EQU   *
         A     R1,RTMSGLEN   ADD TO TOTAL LENGTH
         ST    R1,RTMSGLEN   SET NEW LENGTH
         B     LOOP          AND DO THE NEXT ONE
FAILED   EQU   *
         L     R1,RTMSGFAI   GET FAILURE COUNT
         LA    R1,1(R1)      ADD 1 TO IT
         ST    R1,RTMSGFAI   AND SET NEW FAILURE COUNT
         LA    R3,RTPROG     USER EXIT NAME
         ST    R15,RETCODE   SAVE RETCODE
         WTR   SLS013,(CA,(R3),D,(R15)) ERROR MESSAGE
         B     LOOP          LOOP BACK
DONE     EQU   *
         TM    DBGFLG7,DBGSNDLS    Tracing?
         BNO   SNDDBG99            ---> No
         LINEDIT TEXT='SENDLST : **** All ACTADRs processed ****',     X
               DOT=NO
SNDDBG99 EQU   *
         L     R15,RETCODE
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         SPACE ,
         LTORG ,
SAVE     DS    18F                     SAVE AREA
RETCODE  DS    F
EXPARM   DS    2F
         END   SENDLST
