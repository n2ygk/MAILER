*9/18/86 calculate MAILULEN, MAILNLEN.                           [1.24]
*[1.13] 11/15/83 - added secondary RSCS vmid (RSCSALT)
*[1.12] 4/7/83 - added CP CHANGE RDR #### NOHOLD.
GTSP     TITLE 'CUCCA VM NETWORK MAILER - VERSION 1 -    GET SPOOL FILE*
                INFORMATION'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1986 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
GETSPOOL CSECT ,
* GETSPOOL RETURNS THE PERTINENT INFORMATION ABOUT THE NEXT SPOOL
*  FILE IN THE CARD READER AND PUTS IT IN THE MAILBLOK.
*
*  CALLED VIA - CALL GETSPOOL,(MAILBLOK)
*    MAILBLOK = ADDRESS OF MAILBLOK MACRO EXPANSION
PAB      DSECT ,
@MBLOK   DS    A             ADDRESS OF MAILBLOK
*
*  RETURN CODES IN R15 -
*        0 - NO ERRORS
*        4 - READER EMPTY
         SPACE ,
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 - SPOOL FILE BLOCK BASE
R6  EQU  6 - DIAGNOSE 14 WORK
R7  EQU  7 - DIAGNOSE 14 WORK
R8  EQU  8 - work for calculating MAILULEN,NLEN                  [1.24]
R9  EQU  9 -  "                                                  [1.24]
R10 EQU 10 -
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE ,
         PRINT     NOGEN
         BLOCKS ,
         MAILBLOK ,
         RSCSTAG ,
         EJECT ,
GETSPOOL CSECT
         USING GETSPOOL,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       SKIP EYE-CATCHER
MYNAME   DC    CL8'GETSPOOL',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13)
         LR    R12,R15       GET PERMANENT ADDRESSABILITY
         USING GETSPOOL,R12
         LA    R14,SAVE
         ST    R13,4(R14)
         ST    R14,8(R13)
         LR    R13,R14
         USING PAB,R1        GET PARMS
         L     R11,@MBLOK    GET MBLOK BASE
         DROP  R1
         USING MAILBLOK,R11  ADDRESS THE MAILBLOK
         SPACE ,
*--------------------------------------------------------------------
*        GET THE NEXT READER SPOOL FILE BLOCK AND TAG TEXT (IF ANY)
*--------------------------------------------------------------------
         LA    R5,MAILSFB    ADDRESS OF SPOOL BLOCK
         SR    R6,R6         START AT READER ANCHOR
NEXTBLK  EQU   *             LOOP BACK IF FILE IS IN USE
         LA    R7,X'0FFF'    SUBCODE X'0FFF'
         DC    X'83560014'   DIAGNOSE 14 (SPOOL INPUT)
         BNZ   SFERR         SPOOL FILE ERROR
         SPACE ,
*--------------------------------------------------------------------
*        READ THE SFB AND TAG AND GET THE SENDER NODE AND USERID.
*        ALSO CONVERT THE SPOOL FILE NUMBER TO CHARACTER FOR LATER
*        USE AND SET FLAGS INDICATING THE FILE ORIGIN.
*--------------------------------------------------------------------
         USING SFBLOK,R5     ADDRESSABILITY
         LH    R6,SFBFILID   GET FILE NUMBER
         ST    R6,MAILFILE   SAVE INTO MAILBLOK
         CVD   R6,DWORD      STUFF PACKED DECIMAL
         UNPK  MAILFTXT,DWORD MAKE IT CHARS
         OI    MAILFTXT+L'MAILFTXT-1,X'F0'  FIX THE ZONE
         TM    SFBFLAG,SFBINUSE  IS THE FILE BEING USED?
         BO    NEXTBLK       GET THE NEXT BLOCK
         MVC   ORIGIN(8),SFBORIG   COPY ORIGIN ID INTO MESSAGE
*--------------------------------------------------------------------
* CHECK IF FILE IS FROM RSCS. IF SO, GET USERID AND NODE FROM
* RSCS TAG TEXT. ELSE, GET USERID FROM SFBLOK AND NODE FROM
* LOCAL NODE NAME.
*--------------------------------------------------------------------
         CLC   ORIGIN,RSCSNAME    SEE IF FROM NETWORK
         BE    FROMRSCS      YES, IT'S FROM RSCS
         CLC   ORIGIN,RSCSALT [1.13]Alternate name
         BE    FROMRSCS      [1.13]It's from the other RSCS id.
* NO, IT'S FROM A LOCAL USERID...
         OI    MAILFLG1,MFLG1LCL   LOCAL ORIGIN OF MAIL
         MVC   MAILUSER,ORIGIN    SET THE USER NAME
         MVC   MAILNODE,CPUSTR    SET LOCAL NODE NAME
         B     LOCAL
FROMRSCS EQU   *
         NI    MAILFLG1,255-MFLG1LCL  NOT LOCAL
         LA    R1,MAILTAG    ADDRESS OF TAG
         USING RSCSTAG,R1
         MVC   MAILNODE,RSCSNODE    COPY NODE
         MVC   MAILUSER,RSCSUSER
         DROP  R1
LOCAL    EQU   *
         CLC   MAILUSER,=CL8' ' USERNAME BLANK?
         BNE   USERNB        NOPE
         MVC   MAILUSER,=CL8'MAILER'  SET IT TO MAILER
USERNB   EQU   *
*----------------------------------------------------------------[1.24]
* calculate lengths of MAILNODE, MAILUSER (trim trailing blanks) [1.24]
*----------------------------------------------------------------[1.24]
         LA    R9,MAILUSER             point to user string      [1.24]
         LA    R8,7                    max len-1                 [1.24]
UTRIM    EQU   *                       <-back here when trimming [1.24]
         LA    R1,0(R8,R9)             point to curr char        [1.24]
         CLI   0(R1),C' '              is it a blank?            [1.24]
         BNE   UTRIMOUT                ->no.  Found the end.     [1.24]
         BCT   R8,UTRIM                ->yes, keep on trimming   [1.24]
UTRIMOUT EQU   *                       <-here w/len-1 in R4      [1.24]
         LA    R8,1(,R8)               actual length of name     [1.24]
         ST    R8,MAILULEN             stuff into mailblok       [1.24]
         LA    R9,MAILNODE             point to node string      [1.24]
         LA    R8,7                    max len-1                 [1.24]
NTRIM    EQU   *                       <-back here when trimming [1.24]
         LA    R1,0(R8,R9)             point to curr char        [1.24]
         CLI   0(R1),C' '              is it a blank?            [1.24]
         BNE   NTRIMOUT                ->no.  Found the end.     [1.24]
         BCT   R8,NTRIM                ->yes, keep on trimming   [1.24]
NTRIMOUT EQU   *                       <-here w/len-1 in R4      [1.24]
         LA    R8,1(,R8)               actual length of name     [1.24]
         ST    R8,MAILNLEN             stuff into mailblok       [1.24]
* Write a nice message.                                          [1.24]
         LA    R3,MAILNODE   ADDRESS OF USER NODE AND NAME
         LA    R4,MAILFTXT   ADDRESS OF FILE NUMBER TEXT
         WTR   GTS009,(CA,(R4),CA,ORIGIN,CA,(R3)) WRITE MSG
         CLC   SFBRECSZ,=H'80'  IS IT LRECL 80?
         BNE   BADLRECL      NOPE
*--------------------------------------------------------------------
*[1.12]  change rdr #### nohold in case it was punched in user hold.
*--------------------------------------------------------------------
         MVC   CHFNUM,MAILFTXT         [1.12]file # into command
         LA    R1,CHNOHOLD             [1.12]cmd
         LA    R0,LCHNHLD              [1.12]length
         DC    X'83100008'             [1.12]change it
         TM    SITEOPTS,S#MAINE        [1.12]U.MAINE SPECIAL CASE?
         BZ    NOMAINE                 [1.12]--> nope
         MVC   CHFNUM2,MAILFTXT        [1.12]
         LA    R1,CHFORM               [1.12]Change form to standard
         LA    R0,LCHFORM              [1.12]
         DC    X'83100008'             [1.12]
NOMAINE  EQU   *
         MVC   CHFNUM3,MAILFTXT        [ORDER000] Fill in file #
         LA    R1,CPORDER              [ORDER000] Point to ORDER cmd
         LA    R0,LCPORDER             [ORDER000] Set length
         DC    X'83100008'             [ORDER000] Do it
         SR    R15,R15       ZERO RETURN CODE
RET      EQU   *
         L     R13,4(R13)
         L     R14,12(R13)
         LM    R0,R12,20(R13)
         BR    R14
         SPACE ,
*--------------------------------------------------------------------
*        ERROR RETURNS
*--------------------------------------------------------------------
SFERR    EQU   *
         LA    R15,4
         B     RET
         SPACE ,
*--------------------------------------------------------------------
*  FILE IS NOT LRECL 80 CARD FORMAT....
*--------------------------------------------------------------------
BADLRECL EQU   *
         WTR   GTS035
         LA    R15,8         ERROR
         B     RET
         LTORG ,
SAVE     DS    18F
DWORD    DS    D
ORIGIN   DS    CL8
CHNOHOLD DC    C'CH RDR '              [1.12]Change possible user
CHFNUM   DS    CL4                     [1.12]hold status.
         DC    C' NOHOLD'              [1.12]
LCHNHLD  EQU   *-CHNOHOLD              [1.12]
CHFORM   DC    C'CH RDR '              [1.12]U.Maine special case
CHFNUM2  DS    CL4                     [1.12]of "FORM MAIL" handled
         DC    C' FORM STANDARD'       [1.12]here.
LCHFORM  EQU   *-CHFORM                [1.12]
CPORDER  DC    C'ORDER RDR '           [ORDER000] Order the reader...
CHFNUM3  DS    CL4                     [ORDER000]
LCPORDER EQU   *-CPORDER               [ORDER000]
         END   GETSPOOL
