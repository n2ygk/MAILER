*[1.14] New RFC822 form
ARPADATE TITLE 'BUILD AN ARPA RFC733 FORMAT DATE STRING'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
ARPADATE CSECT ,
* ARPADATE -
* Builds a date and time string in a format compatible with
* the definition of <date-time> in ARPA RFC733 III.D.
* The day of week and time are culled from a CP QUERY TIME
* command.
* sample reply: "TIME IS 14:57:25 EST THURSDAY 04/29/82"
* This is returned as: "Thu, 29 Apr 82 14:57:25 EST"
*
* ENTRY -
*  r1 - address of buffer for result
*
* EXIT -
*  r1 - incremented to point to next character in buffer
*
* LAST EDIT: 4/39/82 by ALAN CROSSWELL
*
*
         SPACE
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 -
R10 EQU 10 -
R11 EQU 11 -
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE
         PRINT NOGEN
         EJECT
ARPADATE CSECT ,
         USING ARPADATE,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'ARPADATE',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING ARPADATE,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         LR    R9,R1         GET A BETTER COPY OF BUFFER PTR
         LR    R8,R1         COPY HERE TOO
*--- ASK CP WHAT TIME IT IS ---*
         LA    R4,=C'QUERY TIME'
         L     R6,=X'4000000A'   LENGTH + REPLY-IN-BUFFER FLAG
         LA    R5,CPTIME     ADDRESS FOR REPLY
         LA    R7,LCPTIME    LENGTH OF THIS BUFFER
         DC    X'83460008'
*--- MOVE THE DAY IN ---*
         MVC   0(3,R9),DAY   only first 3 characters are needed
         NI    1(R9),X'FF'-C' ' lower case 2nd letter
         NI    2(R9),X'FF'-C' ' lower case 3rd letter
         LA    R9,3(R9)      bump pointer
         LA    R2,DAY+6      end of shortest day name
DAYLOOP  EQU   *
         CLI   0(R2),C' '    AT END OF DAY NAME?
         BE    DAYO          OUT OF DAYLOOP
         LA    R2,1(R2)      bump ptr
         B     DAYLOOP
DAYO     EQU   *
         MVC   0(2,R9),=C', '   "Thu, "
         LA    R9,2(R9)      FIX THE PTR
*--- NOW GRAB THE DATE ---*
         LA    R2,1(R2)      POINT TO 1ST DIGIT OF MONTH
         PACK  DWORD,0(2,R2) PACK THE MONTH NUMBER
         MVC   0(2,R9),3(R2) COPY DAY NUMBER
         MVI   2(R9),C' '    "Thu, 29 "
         CVB   R1,DWORD      GET MONTH OFFSET
         SLL   R1,2          GET INTO A MULTIPLE OF 4
         L     R1,MONTAB(R1) GET MONTH NAME (3 CHARS)
         STCM  R1,B'1111',3(R9) "Thu, 29 Apr "
         MVC   7(2,R9),6(R2) GET YEAR NUMBER
         MVC   9(L'CLOCK+L'ZONE,R9),CLOCK  MOVE IN TIMESTAMP
         LA    R9,9+L'CLOCK+L'ZONE(,R9) UPDTE TO END OF STRING
         CLI   ZONE,C'+'     FIRST CHARACTER OF ZONE '+'?
         BE    EXTZONE       YES, EXTEND ZONE
         CLI   ZONE,C'-'     FIRST CHARACTER OF ZONE '-'?
         BNE   EXTZONEE      NEITHER
EXTZONE  DS    0H
         MVC   0(2,R9),=C'00' EXTEND ZONE WITH '00'
         LA    R9,2(,R9)     UPDATE TO END OF STRING
EXTZONEE DS    0H
         OI    0(R8),C' '    UPPER CASE 1ST LETTER OF DAY NAME
         LR    R1,R9         GET UPDATED STRING POINTER
         SR    R15,R15
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         L     R0,20(R13)    RESTORE R0
         LM    R2,R12,28(R13)          GET R2-R12
         BR    R14                     RETURN
         SPACE ,
MONTAB   DS    0F            MONTH NAMES TABLE
         DC C'??? Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec '
         LTORG ,
SAVE     DS    18F                     SAVE AREA
DWORD    DS    D
CPTIME   DC    C'TIME IS'
CLOCK    DC    C' 14:57:25 '
ZONE     DC    C'EST'
         DC    C' '
DAY      DC    C'THURSDAY 04/28/82                           '
LCPTIME  EQU   *-CPTIME
         END   ARPADATE
