LOAD     TITLE 'CUCCA VM NETWORK MAILER - VERSION 1 - LOADER'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
LOAD     CSECT
* LOAD     -
*  Loads the named TEXT deck or TXTLIB member with the OS LOAD
*  SVC.  The routine is loaded in the free storage returned at
*  initialization.  This can fail if the virtual machine size is
*  too small.
*
         SPACE 1
*
*  Invoked via: CALL LOAD,(name)
*
*        name  - CL8, name of exit to load
*
         SPACE 1
PAB      DSECT ,
@NAME    DS    A             ADDRESS OF NAME
         SPACE 1
*
*  Returns:
*        R1  - Address of loaded routine
*        R15 - CMS loader return code
*
*  Calls the loader via the LOAD SVC
*
         SPACE ,
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 - WORK
R2  EQU  2 - WORK
R3  EQU  3 - WORK
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 -
R10 EQU 10 -
R11 EQU 11 - PAB DSECT BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE 1
         PRINT NOGEN
         NUCON DSECT
         FSCBD ,
         DMSABW ,                  Abend work area mapping
         PRINT GEN
         EJECT
LOAD     CSECT ,
         STM   R14,R12,12(R13)         SAVE CALLER'S REGS
         LR    R12,R15                 GET ADDRESSABILITY
         USING LOAD,R12
         LA    R14,SAVE                MY SAVE AREA
         ST    R13,4(R14)              SAVE CALLER'S PTR
         ST    R14,8(R13)              CHAIN MINE BACK
         LR    R13,R14                 SET MY SAVE PTR
         LA    R15,4
         LR    R11,R1        GET PARMS
         USING PAB,R11       DSECT THEM
         SPACE ,
         WAITT ,             [1.13]???
         SPACE 1
*--------------------------------------------------------------------
*        Set up abend recovery environment (in case LOAD fails)
*--------------------------------------------------------------------
         SPACE ,
         ABNEXIT SET,EXIT=LOADFAIL,UWORD=(R12)
         SPACE ,
*--------------------------------------------------------------------
*        Load TEXT file
*--------------------------------------------------------------------
         SPACE ,
         L     R1,@NAME            Point to name
         LOAD  EPLOC=(1)           Load TEXT file
         LR    R2,R0               Get entry address in R2
*                                  (R1 will be destroyed below)
         SPACE 1
*--------------------------------------------------------------------
*        Clear abend recovery environment
*--------------------------------------------------------------------
         SPACE ,
         ABNEXIT CLR,EXIT=LOADFAIL
         SPACE ,
         LR    R1,R2               Get entry address in R1
         SR    R15,R15             Set return code
         B     RET                 Go return
         SPACE 1
         DROP  R12
         SPACE 2
*--------------------------------------------------------------------
*        Abend recovery routine
*--------------------------------------------------------------------
         SPACE 1
LOADFAIL DS    0D
         USING LOADFAIL,R15
         STM   R14,R12,12(R13)     Save registers
         L     R12,=A(LOAD)        Get a better base
         DROP  R15
         USING LOAD,R12
         LR    R2,R1               Copy ABWSECT address
         USING ABWSECT,R2
         L     R1,=A(RET16)        Where we want to restart
         STCM  R1,B'0111',ABNPSW+5 Fix up PSW
         ABNEXIT RESET             Reset exit taken flag
         LA    R13,SAVE            Restore R13
         LPSW  ABNPSW              Continue on
         SPACE 2
*--------------------------------------------------------------------
*        Return
*--------------------------------------------------------------------
         SPACE ,
RET16    EQU   *
         WAITT ,                   Let error message get displayed
         SR    R1,R1               Return 0 for load address
         LA    R15,16              Dummy up return code
         SPACE 1
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         L     R0,20(R13)    RESTORE 0
         LM    R2,R12,28(R13)          GET R2-R12 (RETURN R1)
         BR    R14                     RETURN
         SPACE ,
         LTORG ,
SAVE     DS    18F                     SAVE AREA
         SPACE 1
         END   LOAD
