DISTSUB  TITLE 'VM Network Mailer Version 2 - List distribution subroutX
               ine'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1986 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
DISTSUB  CSECT ,
* DISTSUB  -
*
* This exit implements a distribution list by punching a BSMTP file
* back into the Mailer's reader for processing by the BSMTP code.
* The list of RCPT's is obtained from the parameter list passed to
* this routine.
*
* This code is based on the DISTLIST exit of MAILER release 2.
*
* The generated file will look like:
*  HELO domain
*  TICK message-id
*  MAIL FROM: <sender>     (from MAILSFLD)
*  RCPT TO: <recipient1>   (from parmater list)
*  RCPT TO: <recipient2>
*   . . .
*  RCPT TO: <recipientN>
*  DATA
*   [the mail file itself]
*  .
*  QUIT
*
* The domain that gets plugged into the HELO command is simply the
* Thisnode= string (RSCS node name).
*
         SPACE 1
PAB      DSECT ,
@MBLOK   DS    A             MAILBLOK base
@FILEBLK DS    A             @Fileblock
         SPACE 1
*  The fileblock is the same control block used for EXECs in storage.
*  The FBLDLS field points to the start of the address/length pairs
*  that describe the file lines.  The FBLDLE field contains the total
*  length of the address/length fields in bytes.
*
*        FBLDLS    ---->    A(Line1),A(Length1)
*                           A(Line2),A(Length2)
*                              ...
*                           A(Linen),A(Lengthn)
         SPACE 1
*        Line1              C'string1'
*        Line2              C'string2'
*                              ...
*        Linen              C'stringn'
*
*        n = FBLDLE/8
*
         SPACE 1
*  The lines ('stringn' fields) are assumed to be RFC821 formatted
*  addresses.  The address '<*>' has been reserved as a special value
*  to signify that local delivery of this file should also occur.  This
*  request is signified by a return code of 4 on exit.
         SPACE 1
*  Lines beginning with an asterisk ('*') are ignored as comments.  The
*  asterisk does not have to be in the first column, but must be the
*  first non-blank character on the line.
         SPACE 2
* REGISTER USAGE -
         SPACE 1
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 - Target for executed MVCs
R3  EQU  3 - Source for executed MVCs
R4  EQU  4 - Length for executed instructions
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 - Fileline counter
R9  EQU  9 - Fileline pointer
R10 EQU 10 - FBLOCK base
R11 EQU 11 - MAILBLOK base
R12 EQU 12 - program base
R13 EQU 13 - save area
R14 EQU 14 - linkage
R15 EQU 15 - linkage
         SPACE 3
         FBLOCK ,
         BLOCKS ,
         MAILBLOK ,
         EJECT ,
DISTSUB  CSECT ,
         USING DISTSUB,R15        Temp basing
         B     EYESKIP            around the eye-catcher
MYNAME   DC    CL8'DISTSUB ',CL8'&SYSDATE'
EYESKIP  DS    0H
         STM   R14,R12,12(R13)    save caller's registers
         LR    R12,R15            a better base
         DROP  R15                done with temp base
         USING DISTSUB,R12        get perm base
         LA    R15,SAVE           point to my save area
         ST    R13,4(R15)         play the chain game
         ST    R15,8(R13)
         LR    R13,R15            set up my save pointer
         USING PAB,R1             get to the parms
         L     R11,@MBLOK         MAILBLOK base
         L     R10,@FILEBLK       FBLOCK base
         SPACE 1
         DROP  R1                 done with 'em
         USING FBLOCK,R10         address the FBLOCK
         USING MAILBLOK,R11       address the mailblok
         SPACE 1
         XC    HAVLOCAL,HAVLOCAL  Reset local delivery flag
         SPACE 1
*----------------------------------------------------------------------
* Spool punch to *
*----------------------------------------------------------------------
         LA    R1,=C'SPOOL PUN *' punch back to self
         LA    R0,11              length
         DC    X'83100008'        issue the spool command
*----------------------------------------------------------------------
* Set up the initial items: HELO, TICK, VERB, MAIL...
*----------------------------------------------------------------------
         MVC   HELODOM(8),CPUSTR  copy in rscs node name
         MVC   TICKID,MAILFTXT    message id number
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0102           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,HELO),                      X
               DOT=NO,COMP=NO
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,TICK),                      X
               DOT=NO,COMP=NO
         B     SKIP0104
SKIP0102 EQU   *
         PUNCHC HELO,ERROR=PUNERR punch the HELO record
         PUNCHC TICK,ERROR=PUNERR punch the TICK
SKIP0104 EQU   *
*----------------------------------------------------------------------
* MAIL FROM:<sender> is a little more work...
*----------------------------------------------------------------------
         L     R6,MAILSFLD        sender fieldd
         USING FIELDD,R6          address it
         L     R6,FIPARS          point to adaddr
         DROP  R6                 done with fieldd
         USING MBOX,R6            use the adaddr now
         LA    R2,MAILFROM        address of buffer for userid
         LA    R3,L'MAILFROM(R2)  length of it
         MVI   MAILFROM,C' '      blank it out
         MVC   MAILFROM+1(L'MAILFROM-1),MAILFROM propagate the blanks
         ST    R6,GENMBMBX              Save address of MBOX dsect
         ST    R2,GENMBSTK              Update stack address
         MVC   GENSTKSZ,=A(L'MAILFROM)  Update stack length
         CALL  GENMBOX,(GENMBMBX,GENMBSTR,GENMBSTL,GENMBSTK,GENSTKSZ)
         LTR   R15,R15            did it fit?
         BNZ   OVERFLOW           didn't fit
NODEF    EQU   *
         LR    R15,R2             Copy buffer pointer
         S     R15,=A(MAIL)       Compute length
         C     R15,=F'80'         Longer than 80?
         BH    NODEF2             ---> Yes
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0112           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,MAIL),                      X
               DOT=NO,COMP=NO
         B     SKIP0114
SKIP0112 EQU   *
         PUNCHC MAIL,ERROR=PUNERR punch the MAIL FROM: line
SKIP0114 EQU   *
         DROP  R6                 done with MBOX
         B     DORCPT             --> skip null "from" code
         SPACE 1
NODEF2   EQU   *                  Here if length > 80
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0122           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,(MAIL,79)),                 X
               DOT=NO,COMP=NO
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,(MAIL+79,80)),              X
               DOT=NO,COMP=NO
         B     SKIP0124
SKIP0122 EQU   *
         MVC   TWORK(1),MAIL+79      Save value
         MVI   MAIL+79,X'15'         Put in NL character
         PUNCHC MAIL,ERROR=PUNERR    Punch the MAIL FROM: line
         MVC   MAIL+79(1),TWORK      Restore char
         PUNCHC MAIL+79,ERROR=PUNERR Punch the continuation
SKIP0124 EQU   *
         B     DORCPT
         SPACE 1
*----------------------------------------------------------------------
* Get the recipients,  one per line,  from the in storage list.
* Generate a RCPT TO: line for each one.
*----------------------------------------------------------------------
DORCPT   EQU   *
         L     R9,FBLDLS          Address of first addr/length pair
         L     R8,FBLDLE          Length of addr/length pairs
         SRL   R8,3               Count of addr/length pairs
RCPTLOOP EQU   *                  top of recipient loop
         MVI   RCPTTO,C' '        blank it out
         MVC   RCPTTO+1(L'RCPTTO-1),RCPTTO propagate the blanks
         LA    R2,RCPTTO          Probable target of move
         L     R3,0(R9)           Pick up pointer
         L     R4,4(R9)           Pick up length field
RCPTLO10 EQU   *
         CLI   0(R3),C' '         This a blank?
         BNE   RCPTLO19           ---> No, found first char
         LA    R3,1(,R3)          Bump pointer
         BCT   R4,RCPTLO10        ---> Decrement length
         B     RCPTLO60           ---> All blanks
         SPACE 1
RCPTLO19 EQU   *
         CLI   0(R3),C'*'         Comment record?
         BE    RCPTLO60           ---> Yes
         CLC   =C'<*>',0(R3)      Is it special address?
         BE    RCPTLO90           ---> Yes, remember local forward
         CLI   0(R3),C'<'         Have arrow?
         BE    RCPTLO20           ---> yes
         MVI   0(R2),C'<'         Put it in buffer
         LA    R2,1(,R2)          Bump pointer
RCPTLO20 EQU   *
         BCTR  R4,0               Decrement for EX
         EX    R4,RCPTMVC         Move in string
         LA    R2,0(R4,R2)        End of address
RCPTLO30 EQU   *
         CLI   0(R2),C' '         Is this a blank?
         BNE   RCPTLO35           ---> No, have last character
         BCT   R2,RCPTLO30        Back up 1 and try again
RCPTLO35 EQU   *
         CLI   0(R2),C'>'         Have closing arrow?
         BE    RCPTLO40           ---> Yes
         LA    R2,1(,R2)          Bump pointer
         MVI   0(R2),C'>'         close it off
RCPTLO40 EQU   *
         LA    R15,1(R2)          Next byte
         S     R15,=A(RCPT)       Compute length
         C     R15,=F'80'         Longer than 80?
         BH    RCPTLO50           ---> Yes
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0132           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,RCPT),                      X
               DOT=NO,COMP=NO
         B     SKIP0134
SKIP0132 EQU   *
         PUNCHC RCPT,ERROR=PUNERR punch the MAIL FROM: line
SKIP0134 EQU   *
         B     RCPTLO60           --> Continue
         SPACE 1
RCPTLO50 EQU   *
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0142           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,(RCPT,79)),                 X
               DOT=NO,COMP=NO
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,(RCPT+79,80)),              X
               DOT=NO,COMP=NO
         B     SKIP0144
SKIP0142 EQU   *
         MVC   TWORK(1),RCPT+79   Save value of this char
         MVI   RCPT+79,X'15'      Put in NL character
         PUNCHC RCPT,ERROR=PUNERR punch the MAIL FROM: line
         MVC   RCPT+79(1),TWORK   Restore char
         PUNCHC RCPT+79,ERROR=PUNERR Punch the second line
SKIP0144 EQU   *
         SPACE 1
RCPTLO60 EQU   *
         LA    R9,8(,R9)          To next addr/length pari
         BCT   R8,RCPTLOOP        ---> Have another one left
         B     RCPTDONE           All done
         SPACE 3
RCPTLO90 EQU   *
         MVI   HAVLOCAL,X'01'     Remember '<@>' address found
         B     RCPTLO60           Try for more
         SPACE 1
RCPTMVC  MVC   0(1,R2),0(R3)      Execute MVC
         SPACE 1
RCPTDONE EQU   *
*----------------------------------------------------------------------
* done with RCPT's.  Now send the DATA
*----------------------------------------------------------------------
         TM    DBGFLG6,DBGNOOUT   Sending mail?
         BZ    SKIP0152           ---> Yes
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,DATA),                      X
               DOT=NO,COMP=NO
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,ENDDATA),                   X
               DOT=NO,COMP=NO
         LINEDIT TEXTA=LINESKEL,SUB=(CHARA,QUIT),                      X
               DOT=NO,COMP=NO
         B     SKIP0154
SKIP0152 EQU   *
         PUNCHC DATA,ERROR=PUNERR send the data
         OI    MAILFLG1,MFLG1DOT  do dot quoting
         L     R15,APUNHDR
         CALL  (15),((R11))       send the header
         LTR   R15,R15
         BNZ   RET
         L     R15,APUNTXT
         CALL  (15),((R11))       send the text
         LTR   R15,R15
         BNZ   RET
         PUNCHC ENDDATA,ERROR=PUNERR end the data
         PUNCHC QUIT,ERROR=PUNERR end the "session"
         L     R15,APUNCLS        close the punch
         CALL  (15),((R11))
SKIP0154 EQU   *
RET      EQU   *
         NI    MAILFLG1,255-MFLG1DOT turn off dot quoting
         C     R15,=F'0'          Return code = 0?
         BNE   RET020             ---> No
         C     R15,=F'4'          Return code = 4?
         BNE   RET010             ---> No
         LA    R15,104            Make it not 4
         B     RET020
RET010   EQU   *
         CLI   HAVLOCAL,0         '<@>' address seen?
         BE    RET020             ---> No
         LA    R15,4              Set special return code
RET020   EQU   *
         L     R13,4(R13)
         L     R14,12(R13)
         LM    R0,R12,20(R13)
         BR    R14
         SPACE 1
GENMBSTK DS    A(0)               Stack area for MBOX expansion
GENSTKSZ DS    F'0'               Size of stack area
GENMBMBX DS    A(0)               Address of MBOX dsect
GENMBSTR DS    A(0)               Address of generated MBOX string
GENMBSTL DS    F'0'               Length of generated string
         SPACE ,
OVERFLOW DS    0H                 overflow error
         LOG   DST026,(CA,MYNAME) error message
         LA    R15,4              set error status
OVERPUR  EQU   *
         LA    R1,=C'SP PUN PURGE' purge what's been punched so far
         LA    R0,12              length
         DC    X'83100008'        diagnose 8
         B     RET                and return
         SPACE ,
PUNERR   DS    0H                 punch error
         LOG   DST026,(CA,MYNAME)
         LA    R15,12             fatal error
         B     OVERPUR            do the purge stuff
         EJECT ,
         LTORG ,
SAVE     DS    18F                save area
         SPACE 1
LINESKEL DC      AL1(90)
         DC      CL10'DISTSUB:'
         DC      80C'.'
         SPACE 1
HAVLOCAL DC    X'0'               0 - '<@>' address not found
*                                 1 - '<@>' address found
         SPACE 1
HELO     DC    CL80' '            a helo message
         ORG   HELO               org back to it
         DC    CL5'HELO '         the constant part
HELODOM  DC    CL75' '            the domain that gets filled in
         ORG   ,
         SPACE 1
VERB     DC    CL80'VERB ON'      the verb message
TICK     DC    CL80' '            the tick message
         ORG   TICK
         DC    CL5'TICK '
TICKID   DC    CL4'0000'          the id number
         ORG   ,
         SPACE 1
MAIL     DC    CL160' '           the mail message
         ORG   MAIL
         DC    CL10'MAIL FROM:'
MAILFROM DC    CL150' '           space for the userid
         ORG   ,
         SPACE 1
RCPT     DC    CL160' '           rcpt message
         ORG   RCPT
         DC    CL8'RCPT TO:'
RCPTTO   DC    CL152' '           space for the address
         ORG   ,
         SPACE 1
DATA     DC    CL80'DATA'         data message
         SPACE 1
ENDDATA  DC    CL80'.'            end of data message
         SPACE 1
QUIT     DC    CL80'QUIT'         quit message
         SPACE 1
TWORK    DS    CL1' '
         SPACE 1
         END   DISTSUB
