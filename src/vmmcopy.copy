*COPY    VMM
         PUSH  PRINT
         AIF   ('&SYSPARM' NE 'SUP').NOSUP
         PRINT OFF,NOGEN
.NOSUP   ANOP
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1987 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
* VMM MAIL HEADER FORMAT
VMMIDENT DC    CL6'*:VmmS'   IDENTIFYING PREFIX (CASE SIGNIFICANT)
VMMLINES DC    CL5' '        NUMBER OF LINES IN MESSAGE +1
VMMHLINS DC    CL5' '        NUMBER OF LINES IN HEADER
VMMSUBJ  DC    CL5' '        LINE NUMBER OF SUBJECT FIELD
VMMFROM  DC    CL5' '        LINE NUMBER OF FROM FIELD
VMMTO    DC    CL5' '        LINE NUMBER OF TO FIELD
VMMDATE  DC    CL5' '        LINE NUMBER OF DATE FIELD
VMMCC    DC    CL5' '        LINE NUMBER OF CC FIELD
VMMSENDR DC    CL5' '        LINE NUMBER OF SENDER FIELD
VMMREPTO DC    CL5' '        LINE NUMBER OF REPLY-TO FIELD
         DC    CL5' '        RESERVED FOR FUTURE USE
VMMDATEN DC    CL6'YYMMDD'   STANDARD FORMAT DATE FOR SEARCHING
VMMTIMEN DC    CL6'HHMMSS'   STANDARD FORMAT TIME FOR SEARCHING
VMMKEY   DC    CL8' '        SEARCH KEYWORD
VMMFLAGS DC    CL3' '        USER SPECIFIED FLAGS
VMMLAST  DC    C';'          EACH CARD ENDS WITH A SEMICOLON
VMMLEN   EQU   *-VMMIDENT    LENGTH
         POP   PRINT
