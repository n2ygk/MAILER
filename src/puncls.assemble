PUNCLS   TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - STANDARD PUN CLOSE'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
PUNCLS   CSECT ,
* PUNCLS -
*  STANDARD METHOD OF CLOSING AN OUTPUT MAIL FILE.  THE FILE NAME
*  AND DISTRIBUTION CODE ARE DERIVED FROM THE MAIL SENDER USERID
*  AND HOST NAME.  THE FILE TYPE IS SET TO 'MAIL'.
*
*  LAST EDIT:  5/27/82 BY ALAN CROSSWELL
*
* CALLED VIA -
*  CALL PUNCLS,(MAILBLOK)
PAB      DSECT ,
@MBLOK   DS    F             ADDRESS OF MAILBLOK
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 -
R10 EQU 10 -
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         BLOCKS ,
         MAILBLOK ,
         EJECT
PUNCLS   CSECT ,
         USING PUNCLS,R15    TEMP ADDRESSABILITY
         B     EYESKIP
MYNAME   DC    CL8'PUNCLS',CL8'&SYSDATE'
EYESKIP  DS    0H
         STM   R14,R12,12(R13)
         LR    R12,R15       GET PERM ADDRESSABILITY
         DROP  R15
         USING PUNCLS,R12
         LA    R15,SAVE
         ST    R13,4(R15)
         ST    R15,8(R13)
         LR    R13,R15
         USING PAB,R1
         L     R11,@MBLOK    GET MAILBLOK BASE
         USING MAILBLOK,R11
         DROP  R1
         ICM   R10,B'1111',MAILSFLD  GET FIELDD FOR SENDER
         BZ    SFLDNG        IT'S NO GOOD
         USING FIELDD,R10    ADDRESS IT
         ICM   R10,B'1111',FIPARS  GET MBOX POINTER
         BZ    SFLDNG        BAD SENDER FIELD
         USING MBOX,R10    ADDRESS IT
         ICM   R1,B'1111',MBXLCL Get local address node pointer
         BZ    SFLDNG            ---> Bad sender field
         ST    R1,NODEA          Save for GENLIST call
         LA    R14,STACKP        Stack pointer address ptr
         LA    R15,STACKP+4      Stack size address ptr
         CALL  GENLIST,(NODEA,LSTRA,LSTRL,(14),(15))
         L     R3,LSTRA      Address of user name token
         L     R1,LSTRL      Length of it
         MVC   SENDER,=CL8' ' BLANK OUT SENDER
         C     R1,=F'8'      12 OR LESS
         BL    SEND1         OK
         LA    R1,8          TRUNC IT
SEND1    EQU   *
         BCTR  R1,0          -1 FOR EXECUTE
         LA    R2,SENDER     DEST OF COPY
         EX    R1,COPY       Copy it in:  MVC 0(0,R2),0(R3)
         EX    R1,FILLIT     Change blanks to underscores
         ICM   R9,B'1111',MBXDML  GET HOST NODE POINTER
         BZ    SFLDNG
         USING NODE,R9     ADDRESS IT
         L     R9,NODDOWN    GET POINTER TO HOST NAME TOKEN
         USING TOKEND,R9     ADDRESS IT
         SR    R1,R1         GET A ZERO
         L     R1,TOKLEN     GET LENGTH OF USER NAME
         MVC   CLOSNODE,=CL8' '  BLANK OUT HOST
         C     R1,=F'8'      8 OR LESS
         BL    SEND2         OK
         LA    R1,8          TRUNC IT
SEND2    EQU   *
         BCTR  R1,0          -1 FOR EXECUTE
         LA    R2,CLOSNODE   DEST OF COPY
         L     R3,TOKPTR          SOURCE
         EX    R1,COPY       Copy it in:  MVC 0(0,R2),0(R3)
CLOSE    EQU   *
         LA    R1,CPCLOSE    ADDRESS OF CLOSE COMMAND
         LA    R0,CLOSELEN   LENGTH OF IT
         DC    X'83100008'   DO IT
         LR    R15,R0        GET RC
RET      EQU   *
         L     R13,4(R13)
         L     R14,12(R13)
         LM    R0,R12,20(R13)
         BR    R14
         SPACE ,
SFLDNG   EQU   *
         MVC   SENDER,MAILVMID
         MVC   CLOSNODE,CPUSTR
         B     CLOSE
         SPACE ,
COPY     MVC   0(0,R2),0(R3)
FILLIT   TR    0(0,R2),BLANKTBL
         LTORG ,
SAVE     DS    18F
CPCLOSE  DC    C'CLOSE PUN DIST '
CLOSNODE DS    CL8
         DC    C' NAME '
SENDER   DS    CL8
         DC    C' MAIL',X'15',C'SP PUN CLOSE',X'15',C'SP PUN OFF'
         DC    X'15',C'TAG DEV PUN'
CLOSELEN EQU   *-CPCLOSE
         SPACE 1
NODEA    DC    A(0)                Address of node for GENLIST
LSTRA    DC    A(0)                Address of local part
LSTRL    DC    A(0)                Length of local part
         SPACE 1
BLANKTBL DC    256AL1(*-BLANKTBL)
         ORG   BLANKTBL+C' '       Back to blank
         DC    C'_'                Make blank an underscore
         ORG   ,
         END   PUNCLS
