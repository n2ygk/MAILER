MAILCMD2 TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - 2ND LEVEL COMMAND  *
               PROCESSING ROUTINE'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
MAILCMD2 CSECT ,
* MAILCMD2 -
*
PAB      DSECT ,
@MBLOK   DS    A             MAILBLOK
         SPACE
* REGISTER USAGE -
R0  EQU  0 - Work reg
R1  EQU  1 - Work reg
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 - Console message processing
R5  EQU  5 - Cmd length, return code
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 - COMMAND block base
R10 EQU 10 - Internal subroutine linkage
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         BLOCKS ,
         MAILBLOK ,
         NUCON DSECT
         EJECT
MAILCMD2 CSECT ,
         USING MAILCMD2,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'MAILCMD2',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING MAILCMD2,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         USING PAB,R1        ADDRESS PARMS
         L     R11,@MBLOK    GET MAILBLOK
         DROP  R1
         USING MAILBLOK,R11
         SPACE ,
*--------------------------------------------------------------------
*  REMOVE COMMAND LIST FROM THE MAILCMDL CHAIN.  ANY SMSG INTERRUPTS
*  THAT ADD MORE COMMANDS WILL HAVE TO WAIT UNTIL THE NEXT TIME THIS
*  ROUTINE GETS CALLED.
*--------------------------------------------------------------------
         SSM   =X'FE'        DISABLE SMSG INTERRUPTS
         L     R9,MAILCMDL   GET COMMAND LIST POINTER
         XC    MAILCMDL,MAILCMDL CLEAR THE CHAIN POINTER
         NI    MAILCMD,255-MCMDCMD2  CLEAR THE MAILCMD2 FLAG
         SSM =X'FF'          NOW WE ARE INTERRUPTABLE AGAIN
         SPACE ,
*--------------------------------------------------------------------
*        PROCESS EACH COMMAND ON THE LIST
*--------------------------------------------------------------------
LOOP     EQU   *
         LTR   R9,R9         END OF LIST?
         BZ    RET           TIME TO QUIT
         USING COMMAND,R9    ADDRESS THE DSECT
         CLC   CMDCODE,=A(CMDMLS) Is it distlist?
         BE    $CMDMLS            ---> Yes
         CLC   CMDCODE,=A(CMDFWD) Is it forward?
         BE    $CMDFWD            ---> Yes
         CLC   CMDCODE,=A(CMD202) Is it CMS (SVC202)?
         BE    $CMD202            ---> Yes,
         B     DONE               ---> No, just throw it away
         EJECT ,
* SVC 202 CODE:
         SPACE 1
$CMD202  DS    0H
         LA    R1,CMDDATA    GET DATA ADDRESS
         L     R0,CMDDLEN    GET DATA LENGTH
         ST    R1,ATTNDATA   STUFF INTO ATTN PLIST
         STC   R0,ATTNDATA   STUFF LENGTH TOO
         LA    R1,ATTNPARM   GET ATTN PLIST
         SVC   202           STACK THE DATA
         DC    AL4(*+4)
         LA    R1,SUBSET     CMS SUBSET PLIST
         SVC   202           ISSUE THE COMMAND
         DC    AL4(*+4)
         B     RCMSG
         EJECT ,
* FORWARD command:
         SPACE 1
$CMDFWD  DS    0H
         MVC   $EXCRID,CMDSNDR     Copy requestor's userid
         MVC   $EXCRNOD,CMDNODE    Copy requestor's node
         MVI   $EXCMNT,C'0'        Assume not maintainer
         LR    R1,R9               Copy COMMAND block pointer
         BAL   R14,CHKAUTH         Is user authorized?
         B     $FWD0010            ---> No
         MVI   $EXCMNT,C'1'        Yes, pass it along
$FWD0010 EQU   *
         MVC   $EXCPLFN,=CL8'FORWARD'             Move in command
         MVC   $EXCFBLK(16),=CL16'FORWARD MAILER'     name
         MVC   $EXCREQ,$EXCREQ-1   Blank out field
         ICM   R5,B'1111',CMDDLEN  Get data length
         BZ    $FWD0100            ---> No data
         C     R5,=A(L'$EXCREQ)    Enough space?
         BNH   $FWD0020            ---> Yes
         LA    R5,L'$EXCREQ        No, truncate
$FWD0020 EQU   *
         BCTR  R5,0                Decrement for execute
         EX    R5,MOVEFWD          Move in command arguments
$FWD0100 EQU   *
         LA    R1,$EXCPL           Point to tokenized plist
         ICM   R1,B'1000',=X'01'   Tell REXX using extended plist
         LA    R0,$EXCEPL          Point to extended plist
         SVC   202                 Run the FORWARD exec
         DC    AL4(1)              Continue with next instruction
         C     R15,=F'10001'       Is it exec not found?
         BNE   RCMSG               ---> No
         MVC   $NOFWD,$FWDNONE     Move in message
         LA    R5,L'$NOFWD         Length of message
         BAL   R10,SENDMSG         Send message
         L     R15,=F'10001'       Restore return code
         B     RCMSG
         SPACE 1
$FWDNONE DC    C'FORWARD command not implemented'
         EJECT ,
RCMSG    DS    0H                  Report on result of operation
         MVC   MSGC(14),=C'R(     ) for: '   Initialize
         LR    R5,R15              Get the return code
         CVD   R5,DWORD            Convert it to something readable
         UNPK  MSGRETC,DWORD       Unpack it
         OI    MSGRETC+L'MSGRETC-1,X'F0' Kill the zone
         MVC   MSGDATA,MSGDATA-1   Clear buffer
         L     R5,CMDDLEN          Get data length
         C     R5,=A(L'MSGDATA)    Enough space?
         BNH   RCMSG010            ---> Yes
         LA    R5,L'MSGDATA        No, truncate
RCMSG010 EQU   *
         BCTR  R5,0                Decrement for execute
         EX    R5,MOVEMSG          Move in message
         LA    R5,MSGDATA-MSGC+1(,R5)   Total length
         BAL   R10,SENDMSG              Send the message
         B     DONE
         EJECT ,
***********************************************************************
*
*        M A I L L I S T
*
***********************************************************************
         SPACE 2
$CMDMLS  DS    0H
         MVC   $EXCRID,CMDSNDR     Copy requestor's userid
         MVC   $EXCRNOD,CMDNODE    Copy requestor's node
         MVI   $EXCMNT,C'0'        Assume not maintainer
         LR    R1,R9               Copy COMMAND block pointer
         BAL   R14,CHKAUTH         Is user authorized?
         B     $MLS0010            ---> No
         MVI   $EXCMNT,C'1'        Yes, pass it along
$MLS0010 EQU   *
         MVC   $EXCPLFN,=CL8'MAILLIST'            Move in command
         MVC   $EXCFBLK(16),=CL16'MAILLISTMAILER'     name
         MVC   $EXCREQ,$EXCREQ-1   Blank out field
         ICM   R5,B'1111',CMDDLEN  Get data length
         BZ    $MLS0100            ---> No data
         C     R5,=A(L'$EXCREQ)    Enough space?
         BNH   $MLS0020            ---> Yes
         LA    R5,L'$EXCREQ        No, truncate
$MLS0020 EQU   *
         BCTR  R5,0                Decrement for execute
         EX    R5,MOVEMLS          Move in command arguments
$MLS0100 EQU   *
         LA    R1,$EXCPL           Point to tokenized plist
         ICM   R1,B'1000',=X'01'   Tell REXX using extended plist
         LA    R0,$EXCEPL          Point to extended plist
         SVC   202                 Run the FORWARD exec
         DC    AL4(1)              Continue with next instruction
         C     R15,=F'10001'       Is it exec not found?
         BNE   RCMSG               ---> No
         MVC   $NOMLS,$MLSNONE     Move in message
         LA    R5,L'$NOMLS         Length of message
         BAL   R10,SENDMSG         Send message
         L     R15,=F'10001'       Restore return code
         B     RCMSG
         SPACE 1
$MLSNONE DC    C'MAILLIST command not implemented'
         EJECT ,
*---- Done with this command.  Return the DMSFREE storage ----
         SPACE 2
DONE     EQU   *
         L     R0,CMDLEN     DWORDS USED
         LR    R1,R9
         L     R9,CMDNEXT    GET NEXT COMMAND
         DMSFRET DWORDS=(0),LOC=(1) RETURN TO CMS STORAGE POOL
         B     LOOP          AND DO IT
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         EJECT ,
*        Internal subroutines
         SPACE 2
***********************************************************************
*  SENDMSG - Send a message already formatted in the message buffer   *
*            (MSGDATAX)                                               *
*                                                                     *
*  Entry    R5  - Length of data in MSGDATAX                          *
*           R10 - Return address                                      *
*                                                                     *
*  This routine destroys registers 1, 4 and 5.                        *
*                                                                     *
***********************************************************************
         SPACE 2
SENDMSG  DS    0H
         CLC   CMDSNDR,=CL8'*'     Reply to console?
         BE    CONSOLE             ---> Yes
         SPACE 1
*        Reply via CP MSG/SMSG
         SPACE 1
         MVC   MSGUSER,CMDSNDR     Else use CP (S)MSG command
         MVC   MSGNODE,CMDNODE     Don't forget the nodename.
         MVC   MSGTYPE,CMDMSG
         LA    R1,MSG              Address of the message
         LA    R4,MSGLEN(R5)       Total message length
         DC    X'83140008'         Issue the message
         C     R4,=F'1'            MSGNOH not recognized?
         BNER  R10                 Done with this command
         CLC   =C'MSGNOH ',MSGTYPE Was it a MSGNOH command?
         BNER  R10                 No  : no retry then.
         MVC   MSGTYPE(8),=CL8'MSG' Use good old MSG instead
         LA    R4,MSGLEN(R5)
         DC    X'83140008'
         BR    R10                 ---> Return to caller
         SPACE 3
CONSOLE  DS    0H                  Do it with a WRTERM
         WRTERM MSGC,(R5)
         BR    R10                 ---> Return to caller
         SPACE ,
MOVEMSG  MVC   MSGDATA(0),CMDDATA
MOVEFWD  MVC   $EXCREQ(0),CMDDATA
MOVEMLS  MVC   $EXCREQ(0),CMDDATA
         DROP  R9
         EJECT ,
*        Data areas
         SPACE 2
         LTORG ,
         SPACE 2
SAVE     DS    18F                     SAVE AREA
DWORD    DS    D
         SPACE 1
MSG      DS    0C                  Buffer for msg subroutine
MSGTYPE  DS    CL(L'CMDMSG)        Room for "SMSG rscsname MSG "
MSGNODE  DS    CL8                 Sending user's nodename.
         DC    C' '
MSGUSER  DS    CL8                 Sending user's userid
         DC    C' * '
MSGLEN   EQU   *-MSG
MSGDATAX DC    CL114' '            Your message goes here
         SPACE 1
         ORG   MSGDATAX            Format for return code message
MSGC     DS    C'R('
MSGRETC  DS    CL5
         DS    C') for: '
MSGDATA  DS    CL100
         SPACE 1
         ORG   MSGDATAX            Forward not implemented msg
$NOFWD   DS    CL(L'$FWDNONE)
         SPACE 1
         ORG   MSGDATAX            Distlist not implemented msg
$NOMLS   DS    CL(L'$MLSNONE)
         SPACE 1
         ORG   ,
         SPACE 3
ATTNPARM DC    0D'0',CL8'ATTN',CL4'LIFO'
ATTNDATA DS    F
         DC    8X'FF'
SUBSET   DC    0D'0',CL8'SUBSET',CL8'(RETURN',8X'FF'
         SPACE 2
*  Data areas for FORWARD & MAILLIST command processing
         SPACE 2
         DS    0D
$EXCPL   DC    CL8'EXEC'           Tokenized plist
$EXCPLFN DC    CL8'xxxxxxxx'       FORWARD | MAILLIST
         DC    8X'FF'              Fence for pretty
         SPACE 1
$EXCEPL  DC    A($EXCPL)           Point to 'EXEC'
         DC    A($EXCARGS)         Start of arguments
         DC    A($EXCARGE)         End of arguments
         DC    A($EXCFBLK)         File block pointer
         SPACE 1
$EXCFBLK DS    0F
         DC    CL8'FORWARD'        FN = FORWARD | MAILLIST
         DC    CL8'MAILER'         FT = MAILER
         DC    CL2'*'              FM = *
         DC    H'0'                No extension
         SPACE 1
$EXCARGS DS    0C                  Arguments start here
         DC    C'REQUESTOR ('      Wrapping for id@host
$EXCRID  DC    CL8' '              Requestor's id
         DC    C'@'
$EXCRNOD DC    CL8' '                   and node
         DC    C')'                Wrapping for id@host
         DC    C' '
$EXCMNT  DC    C'0'                Is requestor a maintainer?
         DC    C' '                Used to blank $EXCREQ
$EXCREQ  DC    CL256' '            Original forward command arguments
$EXCARGE EQU   *                   End of arguments
         EJECT ,
***********************************************************************
*                                                                     *
*  CHKAUTH - Check if user is authorized                              *
*                                                                     *
*  Regs on entry:                                                     *
*                                                                     *
*     R9   - COMMAND block base                                       *
*     R14  - Return address                                           *
*                                                                     *
*  Regs on entry:                                                     *
*                                                                     *
*     Unchanged                                                       *
*                                                                     *
*  Exit made to:    R14+0  - Not authorized                           *
*                   R14+4  - Authorized user                          *
*                                                                     *
*                                                                     *
***********************************************************************
         SPACE 1
CHKAUTH  EQU   *                   Check authorization
         SPACE 1
         USING COMMAND,R9
         SPACE 1
         STM   R14,R12,12(R13)     Save regs
         CLC   CMDSNDR,=CL8'*'     Command from console?
         BE    CHKOK
         MVC   AUTHUSER,=CL8' '    Blank out local field
         LA    R14,AUTHUSER        Point to our local field
         LA    R15,CMDSNDR         Point to source
         LA    R1,8                Max to move
CHKSMS02 DS    0H
         CLI   0(R15),C' '         Is it a blank?
         BNE   CHKSMS04            ---> No, first character
         LA    R15,1(,R15)
         BCT   R1,CHKSMS02         ---> Keep trying
         B     CHKNOTOK            ---> All blanks
         SPACE 1
CHKSMS04 DS    0H
         MVC   0(1,R14),0(R15)     Copy 1 character
         LA    R14,1(,R14)         Bump output pointer
         LA    R15,1(,R15)         Bump input pointer
         BCT   R1,CHKSMS04         ---> More to move
         SPACE 1
         LA    R15,MAINTID         Point to first entry of table
CHKSMS10 DS    0H
         CLI   0(R15),X'FF'                    At end of list?
         BE    CHKNOTOK                   ---> Yes, SMSG is illegal
         CLC   MAINTNOD-MAINTID(,R15),=8X'00'  No cpu specified?
         BE    CHKSMS30                   ---> Yes, accept any
         CLC   CMDNODE,=CL8' '                 Command from network?
         BNE   CHKSMS20                   ---> Yes, node id present
         CLC   MAINTNOD-MAINTID(,R15),CPUSTR   Maintainer on this cpu?
         BNE   CHKSMS40                   ---> No, go try next
         B     CHKSMS30                   ---> Yes, go check id
         SPACE 1
CHKSMS20 DS    0H
         CLC   MAINTNOD-MAINTID(,R15),CMDNODE  Maintainer node match?
         BNE   CHKSMS40                   ---> No, go try next
         SPACE 1
CHKSMS30 DS    0H
         CLC   MAINTID-MAINTID(,R15),AUTHUSER  Sender on the list?
         BE    CHKOK                      ---> Yes
         SPACE 1
CHKSMS40 DS    0H
         LA    R15,MAINTID2-MAINTID(R15)  To the next entry
         B     CHKSMS10
         SPACE 1
CHKNOTOK EQU   *
         LM    R14,R12,12(R13)     Restore regs
         B     0(,R14)
         SPACE 1
CHKOK    EQU   *
         LM    R14,R12,12(R13)     Restore regs
         B     4(,R14)
         SPACE 2
         LTORG ,
         SPACE 2
AUTHUSER DC    CL8' '              Used to left justify user id
         SPACE 3
         END   MAILCMD2
