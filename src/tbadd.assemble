*[1.22] Add test for sequential instead of sorted tables         [1.22]
TBADD    TITLE 'TBADD - ADD AN ENTRY TO A TBLUK TABLE'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
TBADD    CSECT
* TBADD    -  ADD AN ENTRY TO A TBLUK TABLE.  THIS FUNCTION
* IS BASED ON THE DEC TOPS-20 JSYS BY THE SAME NAME.
*                            EAC 8/81
* LAST EDIT: 5/17/82 BY ALAN CROSSWELL
*
* CALLED VIA -
*   CALL TBADD,(TABLE,ENTRY,WORK)
*
PAB      DSECT ,
@TABLE   DS    A             ADDRESS OF KEYWORD TABLE
@ENTRY   DS    A             ADDRESS OF ENTRY TO ADD
@WORK    DS    A             ADDRESS OF WORK AREA
*
* NOTE: THE WORK AREA IS USED TO CONSTRUCT A PLIST FOR TBLUK.
*  IT IS ALSO USED BY TBLUK AS THE WORK AREA USED FOR CONVERTING
*  THE TEST AND BASE STRINGS TO UPPER CASE.  IT SHOULD BE THE
*  LENGTH OF THE LONGEST KEYWORD TIMES 2 WITH A MAXIMUM NEEDED
*  OF 2*256 = 512 BYTES.
*
*
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 - INDEX FOR TABLE INSERTION
R8  EQU  8 - ADDRESS OF START OF TABLE IN INSERTION LOOP
R9  EQU  9 - TBENTRY BASE
R10 EQU 10 - TBTAB BASE
R11 EQU 11 - WORK AREA
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
*
         PRINT NOGEN
         TBENTRY ,
         TBTAB DSECT=YES
         TBINI ,
         EJECT ,
TBADD    CSECT ,
         STM   R14,R12,12(R13)
         LR    R12,R15
         USING TBADD,R12
         LA    R15,SAVE
         ST    R13,4(R15)
         LR    R13,R15
         USING PAB,R1        ADDRESS PARMS
         L     R9,@ENTRY     ADDRESS OF ENTRY
         L     R10,@TABLE    ADDRESS OF TABLE
         L     R11,@WORK     GET WORK AREA
         DROP  R1
         USING TBTAB,R10     ADDRESS THE TBTAB
         USING TBENTRY,R9    ADDRESS THE TBENTRY
         L     R1,TB$LEN     GET LENGTH OF TABLE
         C     R1,TB$MAX     COMPARE TO MAX LENGTH
         BL    ROOM          THERE IS ROOM
         LA    R15,4         INDICATE NO ROOM
         B     RET           AND RETURN
ROOM     EQU   *
         L     R8,TBE$STR    ADDRESS OF TBS
         USING TBS,R8        ADDRESS IT
         SR    R1,R1         GET ZERO
         IC    R1,TBS$SIZ    STRING LENGTH
         LA    R8,TBS$STR    ADDRESS OF STRING
         DROP  R8
* BUILD TBLUK PLIST
         ST    R10,0(R11)    STORE TABLE ADDRESS
         ST    R8,4(R11)     STRING ADDRESS
         ST    R1,8(R11)     STORE LENGTH
         ST    R11,12(R11)   REUSE THIS WORK AREA
         LR    R1,R11        ADDRESS THE PLIST
         L     R15,=V(TBLUK)
         BALR  R14,R15
         L     R15,CASE(R15) INDEX INTO CASE TABLE
         BR    R15           GO THERE
CASE     DC    A(EXACT,SUBSTR,AMBIG,NOTFND)  CASE TABLE
         DS    0H
EXACT    EQU   *             EXACT MATCH
         LR    R9,R0         COPY ADDRESS OF MATCHING ENTRY
         LR    R8,R9
         LA    R15,8         THIS IS AN ERROR
         B     RET
SUBSTR   EQU   *             IT'S A SUBSTRING
AMBIG    EQU   *             AMBIGUOUS
NOTFND   EQU   *             NOT FOUND
* INSERT IT BEFORE THE CURRENT ENTRY POINTED TO BY R0
* IN OTHER WORDS, MOVE EVERYTHING FROM (R0) TO END OF CURRENTLY
* ACTIVE TABLE DOWN BY 1 ENTRY.
         LR    R8,R0         MAKE A SAFE COPY
         L     R7,TB$LEN     CURRENT LENGTH IN ENTRIES
         MH    R7,=Y(TBE$LEN)      NUMBER OF BYTES CURRENTLY USED
         A     R7,TB$ADR     ADDED TO ADDRESS OF TABLE
         TM    TB$FLG,TBT#SEQ is it a sequential table?          [1.22]
         BNZ   INSEND        --> insert it at the end            [1.22]
*                                      GIVES END OF CURRENT TABLE
INLOOP   EQU   *             INSERTION LOOP
         SH    R7,=Y(TBE$LEN)      DECREMENT ONE UNIT
         CR    R7,R8         INDEX VS. TOP OF BLOCK
         BL    ENDLOOP       DONE MOVING BLOCK
         MVC   TBE$LEN(TBE$LEN,R7),0(R7)  MOVE DOWN ONE UNIT
         B     INLOOP
ENDLOOP  EQU   *
* NOW INSERT THE NEW GUY
         MVC   0(TBE$LEN,R8),0(R9) MOVE NEW ENTRY IN
         SR    R15,R15       FINE!
         L     R1,TB$LEN     GET LENGTH
         LA    R1,1(R1)      BUMP TABLE LENGTH BY 1
         ST    R1,TB$LEN     AND PUT IT BACK
         LR    R0,R8         POINT TO ENTRY
         B     RET
INSEND   EQU   *             <-- insert unsorted entry at end    [1.22]
         MVC   0(TBE$LEN,R7),0(R9)  tack it on the end           [1.22]
         L     R1,TB$LEN     number entries in table             [1.22]
         LA    R1,1(R1)      add one to it                       [1.22]
         ST    R1,TB$LEN     store it back                       [1.22]
         LR    R0,R7         point to new entry                  [1.22]
         SR    R15,R15       zero return code                    [1.22]
* fall thru to RET                                               [1.22]
RET      EQU   *
         L     R1,TBE$DSP    GET DISPATCH VALUE OF IT
         L     R13,4(R13)
         L     R14,12(R13)
         LM    R2,R12,28(R13)
         BR    R14
*
         LTORG ,
SAVE     DS    18F
         END       TBADD
