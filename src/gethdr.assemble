GETH     TITLE 'CUCCA VM NETWORK MAILER - VERSION 1 -  GETHDR -    READ*
               MESSAGE HEADER INTO CORE'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
GETHDR   CSECT
* GETHDR - READ MESSAGE HEADER.
*  THIS ROUTINE READS A MESSAGE HEADER INTO A BUFFER SUPPLIED BY
*  THE CALLER AND RETURNS.
*
*                                      ALAN CROSSWELL 7/81
*
* LAST EDIT: 4/27/82 BY ALAN CROSSWELL
*
* CALLED VIA - CALL GETHDR,(MAILBLOK)
*   MAILBLOK=ADDRESS OF MAILBLOK MACRO EXPANSION
*
PAB      DSECT ,
@MBLOK   DS    A             ADDRESS OF MAILBLOK
         SPACE ,
* REGISTER USAGE -
R0  EQU  0
R1  EQU  1
R2  EQU  2
R3  EQU  3
R4  EQU  4
R5  EQU  5
R6  EQU  6 -
R7  EQU  7 - STACK POINTER (HEADER PUT HERE)
R8  EQU  8 - STACK LENGTH
R9  EQU  9 - SPOOL FILE NUMBER AND WORK REGISTER
R10 EQU 10 - CARD COUNTER
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA ADDRESS
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE ,
         PRINT NOGEN
         BLOCKS ,
         MAILBLOK ,
         EJECT ,
GETHDR   CSECT ,
         USING GETHDR,R15    TEMPORARY ADDRESSABILITY
         B     EYESKIP       SKIP EYE CATCHER
MYNAME   DC    CL8'GETHDR',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13)
         LR    R12,R15       GET PERMANENT ADDRESSABILITY
         USING GETHDR,R12
         LA    R14,SAVE
         ST    R13,4(R14)
         ST    R14,8(R13)
         LR    R13,R14
         USING PAB,R1        GET PARM
         L     R11,@MBLOK    GET MAILBLOK BASE
         DROP  R1
         USING MAILBLOK,R11
         MVC   MAILHBUF,STACKP   HEADER IS LOADED HERE
         LM    R7,R8,STACKP  GET PTR AND LENGTH IN REGS
         LA    R5,MAILSFB    ADDRESS OF SFBLOK
         USING SFBLOK,R5
         LH    R5,SFBRECSZ   GET LRECL
         DROP  R5
         LA    R1,=C'READY 00C'
         LA    R0,9
         DC    X'83100008'   MAKE SURE IT'S READIED
         LTR   R15,R0        TEST IT
         BNZ   RDERR
         LA    R10,1         START AT CARD 1
         RDCARD BUFFER,(R5),ERROR=EOF  READ FIRST CARD
         CLC   =C':READ',BUFFER  SENT VIA CMS PUNCH COMMAND?
         BNE   RDLOOP1       NOPE, IT'S USEFUL DATA
RDLOOP   EQU   *
         LA    R10,1(R10)    INCREMENT THE CARD COUNTER
         RDCARD BUFFER,(R5),ERROR=EOF  READ A CARD
* NOW GET LENGTH OF RECORD AND STUFF IT INTO THE BUFFER....
RDLOOP1  EQU   *
         LR    R4,R5         COPY LENGHT OF BUFFER
         LA    R3,REVTAB+LREVTAB  ADDR OF END OF REVTAB
         SR    R3,R5         ONLY WANT LAST (R5) BYTES OF IT
         BCTR  R4,0          MINUS 1 FOR EXECUTE
         SR    R1,R1         KILL THE HIGH BYTE
         EX    R4,MOVEREV    COPY REVTAB INTO REVBUF
         EX    R4,TRANS1     REVERSE THE STRING
         EX    R4,TRANS2     GET LENGTH
         BZ    HDREND        BLANK LINE; END OF HEADER.
* R1 POINTS TO 1ST NON-BLANK CHARACTER IN REVERSED STRING
         LA    R2,REVBUF(R5) ADDR OF END OF REVERSED STR.
         SR    R2,R1         LENGTH OF STRING
* NOW ADD THE STRING TO THE BUFFER AND THEN APPEND A LINEND (X'15')
         SR    R8,R2         PAST END OF BUFFER?
         BL    HDRENDOV      YES, Pretend at end of headers
         BCTR  R2,0                MINUS 1 FOR EXECUTE
         EX    R2,COPY       COPY INTO BUFFER
         LA    R7,1(R7,R2)   END OF NEW STRING
         MVI   0(R7),X'15'   TACK ON A LINEND
         LA    R7,1(R7)      POISE PTR. FOR NEXT STRING
         B     RDLOOP
HDRENDOV EQU   *
         AR    R8,R2         Add length not used back in
HDREND   EQU   *
         BCTR  R8,0          -1 FROM STACK FOR THE LINEND
         LTR   R8,R8         TEST IF THERE IS ROOM
         BL    NOSPACE       OUT OF SPACE
         MVI   0(R7),X'15'   ADD THE 2ND LINEND
* NOW SAVE THE LENGTH AND NUMBER OF RECORDS INTO MAILBLOK.
         BCTR  R8,0          -1 FROM STACK
         LA    R7,1(R7)      NEW STACK POINTER
         STM   R7,R8,STACKP  SET NEW STACK POINTERS
         S     R7,MAILHBUF   GET LENGTH OF HEADER
         ST    R7,MAILHBUF+4 SET LENGTH OF HEADER BUFFER
         ST    R10,MAILHREC  SAVE RECORD COUNT
*-------------------------------------------------------------------
* NOW COUNT THE NUMBER OF NL'S IN THE HEADER (USER MAY HAVE IMBEDDED
* MULTIPLE NL'S IN A SINGLE RECORD).
*-------------------------------------------------------------------
         SR    R6,R6         NEWLINE COUNTER
         LM    R7,R8,MAILHBUF GET ADDRESS AND LENGTH
         AR    R8,R7         END ADDRESS
         LA    R3,TRAPTAB    TRAP TABLE
         MVI   X'15'(R3),1   TRAP ONLY X'15'
COUNT15  EQU   *
         CR    R7,R8         AT END OF HEADER?
         BNL   COUNTED       ALL DONE COUNTING
         LR    R4,R8         END ADDRESS
         SR    R4,R7         LENGTH REMAINING
         CH    R4,=Y(256)    MORE THAN ON EXECUTE'S WORTH?
         BNH   *+8           NOPE, JUST DO IT
         LA    R4,256        TRUNC THE SEARCH
         LA    R1,0(R7,R4)   ADDRESS OF END OF TRT IF NO X15'S
         BCTR  R4,0          -1 FOR EXECUTE
         EX    R4,TRAP       TRAP THE X15
         LA    R6,1(R6)      BUMP THE COUNTER
         LA    R7,1(R1)      GET UPDATED POINTER
         B     COUNT15       AND LOOP BACK
COUNTED  EQU   *
         BCTR  R6,0          -1 FOR THE LAST BLANK LINE
         ST    R6,MAILHLIN   SAVE "LINE" COUNT
         MVI   X'15'(R3),0   RESTORE TABLE FOR NEXT GUY
         SR    R15,R15       ALL DONE
RET      EQU   *
         LA    R1,=C'CLOSE RDR'
         LA    R0,9
         DC    X'83100008'             CLOSE THE READER
         L     R13,4(R13)
         L     R14,12(R13)
         LM    R0,R12,20(R13)
         BR    R14
         SPACE ,
*--------------------------------------------------------------------
*        ERROR RETURNS
*--------------------------------------------------------------------
NOSPACE  EQU   *
         WTR   GTH003,(CA,MYNAME)                                [1.24]
         LA    R15,12
         B     RET
         SPACE ,
EOF      EQU   *
         C     R15,=F'1'     IS IT EOF?
         BE    HDREND        END THE HEADER
         WTR   GTH010,(D,(R15)) RDCARD ERROR MESSAGE
         LA    R15,12
         B     RET
RDERR    EQU   *
         WTR   GTH045,(D,(R15))
         LA    R15,12
         B     RET
         SPACE ,
TRAP     TRT   0(0,R7),0(R3)
*
SAVE     DS    18F
BUFFER   DS    CL132
REVBUF   DS    CL132
MOVEREV  MVC   REVBUF(0),0(R3)
TRANS1   TR    REVBUF(0),BUFFER
TRANS2   TRT   REVBUF(0),SKIPBLKS
COPY     MVC   0(0,R7),BUFFER
         LTORG ,
         END   GETHDR
