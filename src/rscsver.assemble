*[1.22]added checking for RSCS-domain                            [1.22]
RSCSVER TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - INCOMING RSCS EXIT'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
RSCSVER  CSECT ,
* RSCSVER -
*  Files from RSCS nodes that are not running  Mailer are checked
*  to make sure that the userid that generated a file matches the
*  userid specified in the from/sender field of the message.
*
*  CALLED VIA -- CALL RSCSVER,(MAILBLOK)
         SPACE ,
PAB      DSECT
@MBLOK   DS    A
         SPACE ,
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 -
R10 EQU 10 -
R11 EQU 11 - MAILBLOK BASE
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE
         PRINT NOGEN
         BLOCKS ,
         MAILBLOK ,
         EJECT
RSCSVER  CSECT ,
         USING RSCSVER,R15   TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'RSCSVER',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING RSCSVER,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         USING PAB,R1        ADDRESS PLIST
         L     R11,@MBLOK    GET MAILBLOK BASE
         DROP  R1
         USING MAILBLOK,R11
         ICM   R10,B'1111',MAILSFLD    GET SENDER FIELD
         BZ    BADFLD        NO SENDER, DIE.
         USING FIELDD,R10    ADDRESS IT
         ICM   R10,B'1111',FIPARS    GET MBOX POINTER
         BZ    BADFLD
         USING MBOX,R10    ADDRESS IT
         ICM   R9,B'1111',MBXLCL    Get userid node pointer
         BZ    BADFLD
         USING NODE,R9     ADDRESS IT
         L     R9,NODDOWN    GET POINTER TO USER NAME TOKEN
         USING TOKEND,R9     ADDRESS IT
         SR    R1,R1         GET A ZERO
         L     R1,TOKLEN     GET LENGTH OF USER NAME
         MVC   SENDER,=CL8' ' BLANK OUT SENDER
         C     R1,=F'8'      12 OR LESS
         BL    SEND1         OK
         LA    R1,8          TRUNC IT
SEND1    EQU   *
         BCTR  R1,0          -1 FOR EXECUTE
         LA    R2,SENDER     DEST OF COPY
         L     R3,TOKPTR          SOURCE
         EX    R1,COPY       COPY IT IN
         EX    R1,UPIT       UPPER CASE
         ICM   R9,B'1111',MBXDML   Get host node pointer
         BZ    BADFLD
         USING NODE,R9     ADDRESS IT
         L     R9,NODDOWN    GET POINTER TO HOST NAME TOKEN
         USING TOKEND,R9     ADDRESS IT
         SR    R7,R7         GET A ZERO                          [1.22]
         L     R7,TOKLEN     GET LENGTH OF host NAME             [1.22]
         L     R2,TOKPTR         address of token                [1.22]
*----------------------------------------------------------------[1.22]
* If any RSCS-domains are defined and the hostname ends in one, then
* strip it off since the various tables don't include them.
*----------------------------------------------------------------[1.22]
         LA    R14,L'RSCSDOM/4     Number of RSCS-Domains.
         LA    R15,RSCSDOM         First RSCS-Domain.
DOMLOOP0 DS    0H
         ICM   R4,B'1111',0(R15) no RSCS domain string defined?
         BZ    NORSCSD       so stop wasting time!               [1.22]
         SR    R5,R5         get a zero                          [1.22]
         IC    R5,0(R4)      get length of domain string         [1.22]
         LR    R3,R5         make a copy for later               [1.22]
         LR    R1,R7         length of token                     [1.22]
         SR    R1,R5         minus length of domain string       [1.22]
         BM    DOMNEXT       token too short to include it
         LA    R1,0(R1,R2)   beginning of possible match         [1.22]
         LA    R4,1(R4)      beginning of domain string          [1.22]
         SR    R0,R0         0 will contain one character        [1.22]
         SR    R6,R6         and 6 the other                     [1.22]
DOMLOOP  EQU   *             loop to compare token end to domain [1.22]
         IC    R0,0(R1)      get next token character            [1.22]
         O     R0,=X'00000040' upper case it                     [1.22]
         IC    R6,0(R4)      get next domain string character    [1.22]
         O     R6,=X'00000040' upper case it too                 [1.22]
         CR    R0,R6         compare the upper case characters   [1.22]
         BNE   DOMNEXT       don't match; try next
         LA    R1,1(R1)      increment pointer                   [1.22]
         LA    R4,1(R4)      ditto for domain string             [1.22]
         BCT   R5,DOMLOOP    loop for length of string           [1.22]
* falling thru here means they match.                            [1.22]
         SR    R7,R3         chop off end of string              [1.22]
         B     DOMDONE
DOMNEXT  DS    0H
         LA    R15,4(,R15)         Try the next RSCS-Domain
         BCT   R14,DOMLOOP0           if there is one.
NORSCSD  EQU   *             no rscs domain given                [1.22]
DOMDONE  EQU   *             fall thru here to old lookup code
         MVC   HOSTNODE,=CL8' '  BLANK OUT HOST
         C     R7,=F'8'      8 OR LESS                           [1.22]
         BL    SEND2         OK
         LA    R7,8          TRUNC IT                            [1.22]
SEND2    EQU   *
         LR    R1,R7         get back into r1 (scotch tape!!!)   [1.22]
         BCTR  R1,0          -1 FOR EXECUTE
         LA    R2,HOSTNODE   DEST OF COPY
         L     R3,TOKPTR          SOURCE
         EX    R1,COPY       COPY IT IN
         EX    R1,UPIT
         CLC   SENDER,MAILUSER  USER AND NODE AGREE?
         BNE   BADSNDR       SORRY
         CLC   HOSTNODE,MAILNODE
         BNE   BADSNDR
         SR    R15,R15
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         SPACE ,
BADFLD   EQU   *
         XC    MAILSFLD,MAILSFLD
BADSNDR  EQU   *
         LA    R15,4
         B     RET
         SPACE ,
COPY     MVC   0(0,R2),0(R3)
UPIT     TR    0(0,R2),UPCASE
         LTORG ,
SAVE     DS    18F                     SAVE AREA
SENDER   DS    CL8
HOSTNODE DS    CL8
         END   RSCSVER
