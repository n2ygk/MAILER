MAILSMSD TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - SMSG DISABLE'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
MAILSMSD CSECT
* MAILSMSD -
*  This routine disables smsgs.
*
* LAST EDIT: 5/14/82 by Alan Crosswell
*
         SPACE
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 -
R10 EQU 10 - VMCPARM BASE
R11 EQU 11 - mailblok base
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         BLOCKS ,
         MAILBLOK ,
         COPY IPARML
         EJECT
MAILSMSD CSECT ,
         USING MAILSMSD,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'MAILSMSD',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING MAILSMSD,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         L     R11,=V(MAILBLOK)
         USING MAILBLOK,R11
         LA    R10,IUCVP
         USING IPARML,R10
         LA    R0,CPSET            Stop
         LA    R1,CPSETL              trapping
         DIAG  R0,R1,X'0008'             (S)MSGs.
         IUCV  SEVER,PRMLIST=(R10),PATHID=MAILIUCP Break *MSG conn.
         IUCV  RTRVBFR             Get our IUCV buffer back.
         STCTL 0,0,CR0       GET CONTROL REGISTER 0
         NI    CR0+3,X'FF'-X'02'   We don't want IUCV interrupts.
         LCTL  0,0,CR0       PUT IT BACK
         HNDEXT CLR          CLEAR EXTERNAL HANDLER
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         SPACE ,
         LTORG ,
SAVE     DS    18F                     SAVE AREA
CR0      DS    F
CPSET    DC    C'SET MSG OFF',X'15',C'SET SMSG OFF'
CPSETL   EQU   *-CPSET
IUCVP    DC    (IPSIZE)D'0'
         END   MAILSMSD
