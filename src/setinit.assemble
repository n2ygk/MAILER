STRLCLH7 DC    Y(11),C'LOCAL-HOST7'
STRLCLH8 DC    Y(11),C'LOCAL-HOST8'
STRLCLH9 DC    Y(11),C'LOCAL-HOST9'
         SPACE 1
*  Table identifiers
         SPACE 1
ROUTING  DC    CL8'Outgoing'
VALID    DC    CL8'Incoming'
         SPACE 1
* The following variable names are related to debugging
         SPACE 1
SMTPTR01 DC    Y(18),C'SMTPIN-TRACE-CALLS'
SMTPTR02 DC    Y(24),C'SMTPIN-TRACE-CHECK-LOCAL'
SMTPTR03 DC    Y(23),C'SMTPIN-TRACE-FIND-ROUTD'
