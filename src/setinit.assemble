STRDOM8  DC    Y(12),C'RSCS-DOMAIN8'
STRDOM9  DC    Y(12),C'RSCS-DOMAIN9'
         SPACE 1
*  Alternate local host name(s)
         SPACE 1
STRLCLDO DC    Y(12),C'LOCAL-DOMAIN'                             [1.22]
STRLCLH1 DC    Y(11),C'LOCAL-HOST1'
STRLCLH2 DC    Y(11),C'LOCAL-HOST2'
