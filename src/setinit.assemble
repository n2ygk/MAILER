SMTPTR05 DC    Y(23),C'SMTPIN-TRACE-REP-MAILER'
SMTPTR06 DC    Y(22),C'SMTPIN-TRACE-S-GETDATA'
SMTPTR07 DC    Y(20),C'SMTPIN-TRACE-S-INPUT'
SMTPTR08 DC    Y(19),C'SMTPIN-TRACE-S-RCPT'
SMTPTR11 DC    Y(19),C'SMTPIN-TRACE-S-MAIL'
SMTPTR12 DC    Y(30),C'SMTPIN-TRACE-PARSE-DATA-HEADER'
MAILTR71 DC    Y(14),C'BUILDLST-TRACE'
         SPACE 2
         END   SETINIT
