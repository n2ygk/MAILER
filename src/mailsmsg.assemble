MAILSMSG TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - SMSG PROCESSOR'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
MAILSMSG CSECT
* MAILSMSG -
*  Commands sent to the mailer via the CP SMSG command are handled
*  in this routine.  This routine runs as the External interrupt
*  handler declared to CMS via the HNDEXT macro.  Since this routine
*  runs disabled,  it does not issue any I/O.  The reentrant
*  command parser MAILCMD1 is called for command processing.
*  Trivial commands (i.e. can be done disabled) are performed
*  in MAILCMD1.  More complex commands are remembered in DMSFREE
*  storage and are processed at a later time by MAILCMD2.
*
* LAST EDIT: 5/12/82 by Alan Crosswell
*
         SPACE
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 -
R8  EQU  8 -
R9  EQU  9 - VMCPARM BASE
R10 EQU 10 - EXTERNAL INTERRUPT SAVE AREA
R11 EQU 11 - mailblok base
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE
         BLOCKS ,
         MAILBLOK ,
         NUCON DSECT
         COPY  IPARML
         COPY  MAILEQU
         EJECT
MAILSMSG CSECT ,
         USING MAILSMSG,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'MAILSMSG',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING MAILSMSG,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         L     R11,=V(MAILBLOK)
         USING MAILBLOK,R11
         LR    R10,R1        COPY PLIST POINTER
         USING EXTSAVE,R10   ADDRESS THE PARMS
         CLC   EXTPSW+2(2),=X'4000' IUCV interrupt?
         BNE   DONE          NOPE, IGNORE IT
         LA    R9,MAILIUCB         Get IUCV external-parms.
         USING IPARML,R9
         CLC   IPPATHID,MAILIUCP   Is it our *MSG path?
         BNE   SEVER               No  : SEVER the path.
         SPACE 3
RCVLOOP  DS    0H
         LA    R9,IUCVP            Now user out IPARML.
         XC    0(IPSIZE*8,R9),0(R9) Clear it out.
         LA    R2,L'MESSAGE
         IUCV  RECEIVE,BUFFER=MESSAGE,BUFLEN=(R2),PRMLIST=(R9),        X
               PATHID=MAILIUCP
         BNZ   DONE                Error: Exit.
         L     R1,IPTRGCLS         Get message type
         C     R1,=F'8'            Class we don't support?
         BH    UNKNOWN             ---> Yes, give error msg
         SLL   R1,2                *4 for index.
         B     *+4(R1)             Process the message
         B     RCVLOOP             0: Undefined.
         B     MSG                 1: MESSAGE/MSGNOHs.
         B     WNG                 2: WARNINGs.
         B     RCVLOOP             3: Asynchronous CP output.
         B     SMSG                4: SMSGs.
         B     RCVLOOP             5: VM output.
         B     CPMSG               6: CP error messages.
         B     CPMSG               7: CP information messages.
         B     RCVLOOP             8: SCIF
         SPACE 3
UNKNOWN  DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP             ---> No, ignore this
         MVC   USER,MESSAGE        Accept userid from IUCV.
         MVC   NODENAME,CPUSTR     It's from our node.
         LA    R5,=CL38'* Unknown (unsupported) IPTRGCLS value'
         LA    R8,38               Message length
         LA    R2,CMDSMSG          Type = SMSG.
         B     EXECUTE
         SPACE 3
WNG      DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BO    SMSG                ---> Yes
         B     RCVLOOP             ---> No, ignore it
         SPACE 3
CPMSG    DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BO    SMSG                ---> Yes
         B     RCVLOOP             ---> No, ignore it
         SPACE 3
SMSG     DS    0H
         MVC   USER,MESSAGE        Accept userid from IUCV.
         MVC   NODENAME,CPUSTR     It's from our node.
         LA    R5,MESSAGE+8        -> Command.
         LA    R8,L'MESSAGE        Get
         SH    R8,IPBFLN1             command
         SH    R8,=H'8'                  length.
         LA    R2,CMDSMSG          Type = SMSG.
         B     EXECUTE
MSG      DS    0H
         CLC   RSCSNAME,MESSAGE    Is it from RSCS?
         BE    MSG1                Yes : Special processing.
         CLC   RSCSALT,MESSAGE     What about the other RSCS?
         BNE   SMSG                No  : Treat it like an SMSG.
MSG1     DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BO    SMSG                ---> Yes
         LA    R8,L'MESSAGE        Get
         SH    R8,IPBFLN1             command
         SH    R8,=H'8'                  length.
         CALL  UNIXSCAN,(PTRS,L'PTRS,MESSAGE+8,(R8))
         CH    R1,=H'6'            At least "FROM node(user):"?
         BL    RCVLOOP             No  : Ignore it.
         LA    R1,PTRS             Assume no message number.
         CLI   0(R1),4             Can it be "FROM"?
         BE    MSG2                Yes : Skip.
         LA    R1,PTRS+4           Skip the DMTCMXnnnI.
         CLI   0(R1),4             Might this one be "FROM"?
         BNE   RCVLOOP             No  : Ignore it.
MSG2     DS    0H
         L     R2,0(,R1)           Is it
         TR    0(4,R2),UPCASE      Upcase it before testing.
         CLC   =C'FROM',0(R2)         "FROM"?
         BNE   RCVLOOP             No  : Exit.
         L     R2,8(,R1)           Is it
         CLI   0(R2),C'('             from a user?
         BNE   RCVLOOP             No  : Message from RSCS itself.
         MVC   NODENAME,=CL8' '    Blank it out.
         IC    R2,4(,R1)           Length of nodename.
         L     R3,4(,R1)           Address of nodename.
         LA    R4,NODENAME
         BCTR  R2,0
         EX    R2,MOVEIT           "MVC 0(*-*,R4),0(R3)".
         MVC   USER,=CL8' '        Blank it out.
         IC    R2,12(,R1)          Length of userid.
         L     R3,12(,R1)          Address of userid.
         LA    R4,USER
         BCTR  R2,0
         EX    R2,MOVEIT           "MVC 0(*-*,R4),0(R3)".
         L     R5,24(,R1)          Address of command.
         LA    R5,0(,R5)           Purify address.
         LA    R8,MESSAGE+L'MESSAGE Get
         SH    R8,IPBFLN1             command
         SR    R8,R5                     length.
         LA    R2,CMDNET           Type = Network.
         B     EXECUTE
MOVEIT   MVC   0(*-*,R4),0(R3)     *** Executed ***
EXECUTE  DS    0H
         CALL  MAILCMD1,((R11),(R5),(R8),USER,NODENAME,(R2))
         B     RCVLOOP             Go check for more.
         SPACE 3
SEVER    DS    0H
         IUCV  SEVER,PRMLIST=(R9)  Kill any paths except *MSG.
         SPACE 3
DONE     EQU   *
         SR    R15,R15
         TM    MAILSTAT,MSTINWT   IN WAITD?
         BNO   RET
         LA    R0,=C'QUERY FILES'  Command.
         LA    R1,MESSAGE          Output area.
         L     R2,=AL1(X'40',0,0,11) Length + Output-in-Buffer flag
         LA    R3,40               Enough for "FILES: nnn RDR ..."
         DIAG  R0,R2,X'0008'       Get the file counts.
         CLC   MESSAGE+7(3),=C' NO' Any files waiting?
         BE    RET                 No  : Let sleeping MAILERs lie.
         LA    R1,=C'READY C'
         LA    R0,7
         DC    X'83100008'   WAKE UP THE SLEEPING MAILER
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         LTORG ,
SAVE     DS    18F                     SAVE AREA
NODENAME DS    CL8                 Name of sending node.
USER     DS    CL8                 Name of sending user.
MESSAGE  DS    CL256               IUCV RECEIVE buffer.
IUCVP    DS    (IPSIZE)D
PTRS     DS    CL(10*4)
         SPACE ,
EXTSAVE  DSECT ,
EXTGRS   DS        16F
EXTFRS   DS        8F
EXTPSW   DS        D
         END   MAILSMSG
