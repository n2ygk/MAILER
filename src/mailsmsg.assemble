MAILSMSG TITLE 'CUCCA VM NETWORK MAILER VERSION 1 - SMSG PROCESSOR'
*---------------------------------------------------------------------*
*      MAILER -- Copyright (c) 1982,1985 Columbia University.         *
*    Program Property of the Trustees of Columbia University in the   *
*    City of New York.                                                *
*---------------------------------------------------------------------*
MAILSMSG CSECT
* MAILSMSG -
*  Commands sent to the mailer via the CP SMSG command are handled
*  in this routine.  This routine runs as the External interrupt
*  handler declared to CMS via the HNDEXT macro.  Since this routine
*  runs disabled,  it does not issue any I/O.  It either severs
*  the IUCV connection or receives the data being transmitted.  If
*  data is received, a copy of the data buffer and IUCV parms buffer
*  is stacked for processing by the MAILCMDx routines.
*
         SPACE
* REGISTER USAGE -
R0  EQU  0 -
R1  EQU  1 -
R2  EQU  2 -
R3  EQU  3 -
R4  EQU  4 -
R5  EQU  5 -
R6  EQU  6 -
R7  EQU  7 - IUCV receive block base
R8  EQU  8 -
R9  EQU  9 - VMCPARM BASE
R10 EQU 10 - EXTERNAL INTERRUPT SAVE AREA
R11 EQU 11 - mailblok base
R12 EQU 12 - PROGRAM BASE
R13 EQU 13 - SAVE AREA
R14 EQU 14 - SUBROUTINE LINKAGE
R15 EQU 15 - SUBROUTINE LINKAGE
         SPACE
         BLOCKS ,
         MAILBLOK ,
         NUCON DSECT
         COPY  IPARML
         MSGBLOK ,
         COPY  MAILEQU
         EJECT
MAILSMSG CSECT ,
         USING MAILSMSG,R15  TEMPORARY ADDRESSABILITY
         B     EYESKIP       BRANCH OVER EYESKIP
MYNAME   DC    CL8'MAILSMSG',CL8'&SYSDATE'
EYESKIP  DS    0H
         DROP  R15
         STM   R14,R12,12(R13) SAVE CALLER'S REGS
         LR    R12,R15       PERMANENT ADDRESSABILITY
         USING MAILSMSG,R12
         LA    R14,SAVE      MY SAVE AREA
         ST    R13,4(R14)    SAVE CALLER'S PTR
         ST    R14,8(R13)    CHAIN MINE BACK
         LR    R13,R14       SET MY SAVE PTR
         L     R11,=V(MAILBLOK)
         USING MAILBLOK,R11
         LR    R10,R1        COPY PLIST POINTER
         USING EXTSAVE,R10   ADDRESS THE PARMS
         LA    R7,0                Signal no MSGBLOK gotten yet
         CLC   EXTPSW+2(2),=X'4000' IUCV interrupt?
         BNE   DONE          NOPE, IGNORE IT
         LA    R9,MAILIUCB         Get IUCV external-parms.
         USING IPARML,R9
         CLC   IPPATHID,MAILIUCP   Is it our *MSG path?
         DROP  R9
         BNE   SEVER               No  : SEVER the path.
         SPACE 3
RCVLOOP  DS    0H
         DMSFREE DWORDS=MSGBLOKL/8,ERR=DONE
*                                  Ignore interrupt if no storage
         LR    R7,R1               Base into better reg
         USING MSGBLOK,R7          Map it for assembler
         LR    R14,R7              Start of area to clear
         L     R15,=A(MSGBLOKL)    Length to clear
         LA    R1,0                Set from length of 0 and pad of x'0'
         MVCL  R14,R0              Clear MSGBLOK to zeros
         ST    R0,MSGBLEN          Remember length
         MVC   SRCNODE,=CL8' '     Init to blanks
         MVC   SRCUSER,=CL8' '     Init to blanks
RCVLOOP2 EQU   *                   Come here if block already gotten
         XC    MAILIPRM(IPSIZE*8),MAILIPRM Clear it out.
         LA    R15,L'MESSAGE
         LA    R9,MAILIPRM         Base for IPARML
         USING IPARML,R9           Tell assembler
         IUCV  RECEIVE,BUFFER=MESSAGE,BUFLEN=(R15),PRMLIST=(R9),       X
               PATHID=MAILIUCP
         BNZ   DONE                Error: Exit.
         L     R1,IPTRGCLS         Get message type
         C     R1,=F'8'            Class we don't support?
         BH    UNKNOWN             ---> Yes, give error msg
         SLL   R1,2                *4 for index.
         B     *+4(R1)             Process the message
         B     RCVLOOP             0: Undefined.
         B     MSG                 1: MESSAGE/MSGNOHs.
         B     WNG                 2: WARNINGs.
         B     RCVLOOP             3: Asynchronous CP output.
         B     SMSG                4: SMSGs.
         B     RCVLOOP             5: VM output.
         B     CPMSG               6: CP error messages.
         B     CPMSG               7: CP information messages.
         B     RCVLOOP             8: SCIF
         SPACE 3
UNKNOWN  DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP2            ---> No, ignore this
         MVC   SRCUSER,MESSAGE     Accept userid from IUCV.
         MVC   SRCNODE,CPUSTR      It's from our node.
         MVC   MESSAGE(38),=CL38'* Unknown (unsupported) IPTRGCLS valueX
               '
         LA    R15,MESSAGE         Start of message
         ST    R15,@MESSAGE        Into MSGBLOK
         MVC   @MSGLEN,=F'38'      Message length
         MVC   SRCCODE,=A(CMDSMSG) Type = SMSG.
         B     QUEUEIT
         SPACE 3
WNG      DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BO    SMSG                ---> Yes
         B     RCVLOOP2            ---> No, ignore it
         SPACE 3
CPMSG    DS    0H
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BO    SMSG                ---> Yes
         B     RCVLOOP2            ---> No, ignore it
         SPACE 3
SMSG     DS    0H
         MVC   SRCUSER,MESSAGE     Accept userid from IUCV.
         MVC   SRCNODE,CPUSTR      It's from our node.
         LA    R15,MESSAGE+8       -> Command.
         ST    R15,@MESSAGE        Into MSGBLOK
         LA    R15,L'MESSAGE       Get
         SH    R15,IPBFLN1            command
         SH    R15,=H'8'                 length.
         ST    R15,@MSGLEN         Into MSGBLOK
         MVC   SRCCODE,=A(CMDSMSG) Type = SMSG.
         B     QUEUEIT
         SPACE 1
MSG      DS    0H
         CLC   RSCSNAME,MESSAGE    Is it from RSCS?
         BE    MSG1                Yes : Special processing.
         CLC   RSCSALT,MESSAGE     What about the other RSCS?
         BNE   SMSG                No  : Treat it like an SMSG.
MSG1     DS    0H
         LA    R14,MESSAGE+8       Message address
         LA    R15,L'MESSAGE       Get
         SH    R15,IPBFLN1            command
         SH    R15,=H'8'                 length.
         CALL  UNIXSCAN,(PTRS,L'PTRS,(R14),(R15))
         CH    R1,=H'6'            At least "FROM node(user):"?
         BNL   MSG1B               ---> Yes
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP2            ---> No, ignore it
         B     SMSG                Pretend it was an SMSG
         SPACE 1
MSG1B    EQU   *
         LA    R1,PTRS             Assume no message number.
         CLI   0(R1),4             Can it be "FROM"?
         BE    MSG2                Yes : Skip.
         LA    R1,PTRS+4           Skip the DMTCMXnnnI.
         CLI   0(R1),4             Might this one be "FROM"?
         BE    MSG2                ---> Yes, keep trying
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP2            ---> No, ignore it
         B     SMSG                Pretend it was an SMSG
         SPACE 1
MSG2     DS    0H
         L     R2,0(,R1)           Is it
         TR    0(4,R2),UPCASE      Upcase it before testing.
         CLC   =C'FROM',0(R2)         "FROM"?
         BE    MSG2B               ---> Yes
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP2            ---> No, ignore it
         B     SMSG                Pretend it was an SMSG
         SPACE 1
MSG2B    EQU   *
         L     R2,8(,R1)           Is it
         CLI   0(R2),C'('             from a user?
         BE    MSG2C               ---> Yes
         TM    MAILOPTS,MOPTALLM   Display all received messages?
         BNO   RCVLOOP2            ---> No, ignore it
         B     SMSG                Pretend it was an SMSG
         SPACE 1
MSG2C    EQU   *
         MVC   SRCNODE,=CL8' '     Blank it out.
         IC    R2,4(,R1)           Length of nodename.
         L     R3,4(,R1)           Address of nodename.
         LA    R4,SRCNODE
         BCTR  R2,0
         EX    R2,MOVEIT           "MVC 0(*-*,R4),0(R3)".
         MVC   SRCUSER,=CL8' '     Blank it out.
         IC    R2,12(,R1)          Length of userid.
         L     R3,12(,R1)          Address of userid.
         LA    R4,SRCUSER
         BCTR  R2,0
         EX    R2,MOVEIT           "MVC 0(*-*,R4),0(R3)".
         L     R14,24(,R1)         Address of command.
         LA    R14,0(,R14)         Purify address.
         ST    R14,@MESSAGE        Into MSGBLOK
         LA    R15,MESSAGE+L'MESSAGE Get
         SH    R15,IPBFLN1             command
         SR    R15,R14                    length.
         ST    R15,@MSGLEN         Into MSGBLOK
         MVC   SRCCODE,=A(CMDNET)  Type = Network.
         B     QUEUEIT
         SPACE 1
MOVEIT   MVC   0(*-*,R4),0(R3)     *** Executed ***
         SPACE 1
         DROP  R9
         SPACE 1
QUEUEIT  DS    0H
         BAL   R14,CHAINIT
         B     RCVLOOP             Go check for more.
         SPACE 3
SEVER    DS    0H
         USING IPARML,R9
         IUCV  SEVER,PRMLIST=(R9)  Kill any paths except *MSG.
         DROP  R9
         SPACE 3
DONE     EQU   *
         LTR   R7,R7               Have a block to free?
         BZ    DONE2               ---> No
         LR    R1,R7               Move it (dumb CMS macro)
         DMSFRET LOC=(1),DWORDS=MSGBLOKL/8,ERR=*
         SPACE 1
         DROP  R7
DONE2    EQU   *
         SR    R15,R15
         TM    MAILSTAT,MSTINWT   IN WAITD?
         BNO   RET
         LA    R0,=C'QUERY FILES'  Command.
         LA    R1,FILESMSG         Output area.
         L     R2,=AL1(X'40',0,0,11) Length + Output-in-Buffer flag
         LA    R3,40               Enough for "FILES: nnn RDR ..."
         DIAG  R0,R2,X'0008'       Get the file counts.
         CLC   FILESRDR,=C' NO'    Any files waiting?
         BE    RET                 No  : Let sleeping MAILERs lie.
         LA    R1,=CL9'READY 00C'
         LA    R0,9
         DC    X'83100008'   WAKE UP THE SLEEPING MAILER
         SPACE 1
RET      EQU   *
         L     R13,4(R13)              GET CALLER'S SAVE PTR
         L     R14,12(R13)             GET R14
         LM    R0,R12,20(R13)          GET R0-R12
         BR    R14                     RETURN
         EJECT ,
*--------------------------------------------------------------------
*
*  Add command block to MAILCMDL chain
*
*  Regs at entry:
*
*    R7  - MSGBLOK base
*    R14 - Return address
*
*--------------------------------------------------------------------
         SPACE 1
CHAINIT  DS    0H
         LA    R15,MAILCMDL        Address of list
CHAIN10  EQU   *
         ICM   R1,B'1111',0(R15)   Get next command pointer
         BZ    CHAIN20             Found end of chain
         USING MSGBLOK,R1
         LA    R15,MSGNEXT         Chain along
         DROP  R1
         B     CHAIN10
CHAIN20  EQU   *
         ST    R7,0(R15)           Add onto chain
         OI    MAILCMD,MCMDCMD     Indicate there is work to do
         OI    CMDECB,POSTED       And post the command ECB.
         BR    R14                 Return to caller
         EJECT ,
         LTORG ,
SAVE     DS    18F                     SAVE AREA
PTRS     DS    CL(10*4)            Used by UNIXSCAN
FILESMSG DS    C'FILES: '          Response from Q FILES goes here
FILESRDR DS    C'nnn'
         DS    C' RDR, '
FILESPRT DS    C'nnn'
         DS    C' PRT, '
FILESPUN DS    C'nnn'
         DS    C' PUN. '
         SPACE ,
EXTSAVE  DSECT ,
EXTGRS   DS        16F
EXTFRS   DS        8F
EXTPSW   DS        D
         END   MAILSMSG
