/* ***************************************************************** */
/*  FWD - Add a mail/file forwarding entry to the mailer FORWARDing  */
/*        files for a user.                                          */
/* ***************************************************************** */
/*                                                                   */
/*              (c) Copyright Princeton University 1990              */
/*                                                                   */
/* ***************************************************************** */
/*                                                                   */
/*  command format:                                                  */
/*                                                                   */
/*      FWD   < parameters > < ( options >                           */
/*                                                                   */
/*                                                                   */
/*  parameters:                                                      */
/*                                                                   */
/*      DELeteall                                                    */
/*                                                                   */
/*      DELFILEforward   address                                     */
/*                                                                   */
/*      DELMAILforward   address                                     */
/*                                                                   */
/*      FILEforward  address  class(es)  LOGGEDOFF|ANYTIME           */
/*                                                                   */
/*      LIst                                                         */
/*                                                                   */
/*      MAILfoward  address                                          */
/*                                                                   */
/*  options:                                                         */
/*                                                                   */
/*      FOR userid                                                   */
/*                                                                   */
/*      FORCE                                                        */
/*                                                                   */
/*      MAILERid  userid                                             */
/*                                                                   */
/*      TRACE                                                        */
/*                                                                   */
/*  See the help file for a complete description of the parameters   */
/*  and options.                                                     */
/*                                                                   */
/*  *** Note *** The userid existence check is currently not         */
/*               implemented.                                        */
/*                                                                   */
/* ***************************************************************** */

address "COMMAND"
parse arg parms "(" options ")" .

signal on halt
signal on syntax
signal on novalue

if parms = '?' | parms = ''  then  do        /* Handle help request   */
   address cms 'HELP FWD'
   exit
   end

/* ****************************************************************** */
/*                          Initializations                           */
/* ****************************************************************** */

/* ------------------------------------------------------------------ */
/*                       Site dependent values                        */
/* ------------------------------------------------------------------ */

mailerid = 'MAILER'                          /* MAILER userid         */

'IDENTIFY ( LIFO'                            /* Local node name       */
parse pull userid . localnode .

/* ------------------------------------------------------------------ */
/*                   End of site dependent values                     */
/*                                                                    */
/*                             ---------                              */
/*                                                                    */
/*                      Site independent values                       */
/* ------------------------------------------------------------------ */

delete  = 0
error   = 0
filedel = 0
filefwd = 0
force   = 0
list    = 0
maildel = 0
mailfwd = 0
trace   = 0

creationdate = ''
updatedate   = ''

/* ****************************************************************** */
/*                      End of initializations                        */
/* ****************************************************************** */

totaloptions = words(options)                /* Total options         */
do i=1 to totaloptions
   option = translate(word(options,i))       /* Get next possible opt */
   select
      when option = 'FOR'  then  do          /* FOR userid            */
         if i=totaloptions  then  do         /* Missing pieces        */
            say 'Userid for FOR option not supplied'
            error = 1
            end
         else  do                            /* Maybe ok              */
            userid = word(options,i+1)       /* Get userid            */
            i = i + 1                        /* Update loop counter   */
            end
         end
      when option = 'FORCE'  then            /* FORCE                 */
         force = 1
      when abbrev('MAILERID',option,5) then do /* MAILERID            */
         if i=totaloptions  then  do         /* Missing pieces        */
            say 'Userid for MAILERID option not supplied'
            error = 1
            end
         else  do                            /* Maybe ok              */
            mailerid = word(options,i+1)     /* Get userid            */
            i = i + 1                        /* Update loop counter   */
            end
         end
      when option = 'TRACE'  then            /* TRACE                 */
         trace = 1
      otherwise  do
         say 'Unrecognized option "'option'"'
         error = 1
         end
      end
   end

if error  then  do
   say 'FWD stopping due to parameter error(s)'
   exit 8
   end

parse var userid userid'@'node .             /* See if node provided  */
if node = ''  then  node = localnode         /* Set if not there      */
upper userid node

if node <> localnode  then  do               /* Working with local?   */
   say 'The id to be forwarded must be on the local node' ,
      '('localnode') not on' node
   exit 8
   end

if length(userid) > 8  then  do
   say "Userid '"userid"' is longer than 8 characters."
   exit 8
   end

if trace  then  trace ?r                     /* Trace if requested    */

temp = getloc()
parse upper var temp address mode .
if mode = ''  then  do
   say 'Unable to find a free disk mode for accessing forwarding data' ,
       'disk'
   exit 4
   end

call link mailerid '191' address 'RR'        /* Link to mailer 191    */
if result <> 0  then  exit result            /* Link failed           */
"ACCESS" address mode
say ' '

call getoldinfo mode                         /* Get any old info      */

delfiles = 0                                 /* Set counters          */
delmail  = 0
newfiles = 0
newmail  = 0

totalparms = words(parms)
do i=1 to totalparms
   parm = translate(word(parms,i))           /* Take next parm        */
   select
      when abbrev('DELETEALL',parm,3)  then  /* Deletion request      */
         delete = 1
      when abbrev('DELFILEFORWARD',parm,4) | ,
           abbrev('DELETEFILEFORWARD',parm,7)  then  do
         select                              /* File deletion         */
            when i=totalparms  then  do      /* Missing pieces        */
               say 'Destination address not supplied for file' ,
                  'forwarding deletion'
               error = 1
               end
            otherwise  do                    /* Maybe ok              */
               delfiles = delfiles + 1       /* Bump counters         */
               delfilesdest.delfiles  = word(parms,i+1)
               i = i + 1                     /* Update loop counter   */
               filedel = 1                   /* Remember we had one   */
               end
            end
         end
      when abbrev('DELMAILFORWARD',parm,4) | ,
           abbrev('DELETEMAILFORWARD',parm,4)  then  do
         select                              /* Mail deleteion        */
            when i=totalparms  then  do      /* Missing pieces        */
               say 'Destination address not supplied for file' ,
                  'forwarding deletion'
               error = 1
               end
            otherwise  do                    /* Maybe ok              */
               delmail = delmail + 1         /* Bump counters         */
               delmaildest.delmail  = word(parms,i+1)
               i = i + 1                     /* Update loop counter   */
               maildel = 1                   /* Remember we had one   */
               end
            end
         end
      when abbrev('FILEFORWARD',parm,4) then do /* File forwarding    */
         select
            when i=totalparms  then  do      /* Missing pieces        */
               say 'Destination, class(es) and logon status not' ,
                   'supplied for file forwarding'
               error = 1
               end
            when i+1=totalparms  then  do    /* Missing pieces        */
               say 'Class(es) and logon status not supplied for file' ,
                  'forwarding'
               error = 1
               end
            when i+2=totalparms  then  do    /* Missing pieces        */
               say 'Logon status not supplied for file forwarding'
               error = 1
               end
            otherwise  do                    /* Maybe ok              */
               newfiles = newfiles + 1       /* Bump counters         */
               newfilesdest.newfiles  = word(parms,i+1)
               parm2 = word(parms,i+2)       /* Standardize class     */
               newclasses = left(parm2,1)    /*   string              */
               do j=2 for length(parm2)
                  classx = substr(parm2,j,1) /* Next character        */
                  if pos(classx,newclasses) = 0  then
                     newclasses = newclasses||classx
                  end
               newfilesclass.newfiles = newclasses
               newfileslogon.newfiles = translate(word(parms,i+3))
               loggedon  = (newfileslogon.newfiles = 'ANYTIME')
               loggedoff = (newfileslogon.newfiles = 'LOGGEDOFF')
               if ^loggedon & ^loggedoff  then  do
                  say 'Logon status for file destination of' ,
                     newfilesdest.newfiles 'not ANYTIME or LOGGEDOFF'
                  error = 1
                  end
               i = i + 3                     /* Update loop counter   */
               filefwd = 1                   /* Remember we had one   */
               end
            end
         end
      when abbrev('FORCE',parm,3)  then      /* Force if necessary    */
         force = 1
      when abbrev('LIST',parm,2)  then       /* List request          */
         list = 1
      when abbrev('MAILFORWARD',parm,4) then do /* File forwarding    */
         select
            when i=totalparms  then  do      /* Missing pieces        */
               say 'Destination not supplied for mail forwarding'
               error = 1
               end
            otherwise  do                    /* Maybe ok              */
               newmail = newmail + 1         /* Bump counters         */
               newmaildest.newmail = word(parms,i+1)
               i = i + 1                     /* Update loop counter   */
               mailfwd = 1                   /* Remember we had one   */
               end
            end
         end
      otherwise  do                          /*                       */
         say 'Unrecognized parameter "'parm'"'
         error = 1                           /*                       */
         end
      end
   end

if delete & (filedel | filefwd | maildel | mailfwd | list)  then  do
   excludelist = ''
   if filedel  then  excludelist = 'DELFILEforward '
   if filefwd  then  excludelist = excludelist || 'FILEforward '
   if list     then  excludelist = excludelist || 'LIST '
   if maildel  then  excludelist = excludelist || 'DELMAILforward '
   if mailfwd  then  excludelist = excludelist || 'MAILforward '
   say 'DELETE is mutually exclusive with the' ,
      formatlist(excludelist) 'parameters'
   error = 1
   end

if error  then  do
   say 'FWD stopping due to parameter error(s)'
   exitrc = 8
   signal exit
   end

if list & (filefwd | mailfwd)  then          /* Soft error            */
   list = 0                                  /* Will do this anyway   */

if ^(delete | filedel | filefwd | maildel | mailfwd | list)  then
   list = 1                                  /* Default is list       */

select
   when list  then  do                       /* Just listing info     */
      'VMFCLEAR'                             /* Clear screen          */
      say ' '
      say 'Current forwardings in effect for' userid':'
      say ' '
      call listforward                       /*                       */
      if creationdate <> ''  then  do
         say ' '
         say 'Created:' creationdate '   Updated:' updatedate
         end
      exitrc = 0                             /*                       */
      end
   when delete & forward.0 = 0  then  do     /* Delete but no forward */
      say 'Forwarding not in effect for' userid
      exitrc = 4
      end
   otherwise  do                             /* Addition request      */
      if delete  then  do                    /* Delete all request    */
         say 'Deleting any existing mail and file forwards'
         forward.0 = 0                       /* No mail forwards      */
         fileforward.0 = 0                   /* No file forwards      */
         end
      else                                   /* Not delete all        */
         call update                         /* Build new sample      */
      say ' '
      if error  then  do                     /* Fatal errors          */
         say 'Correct errors and reissue command'
         exitrc = 8
         end
      else  do                               /* No errors             */
         say 'After applying requested changes the following' ,
             'forwarding(s) will be in effect:'
         say ' '
         call listforward                    /* Show the results      */
         if doforward()  then                /* A chance to stop      */
            call sendcmds                    /* Send the update       */
         else                                /* Don't do update       */
            say 'No changes made'
         exitrc = 0
         end
      end
   end

Exit:
say ' '
"RELEASE" mode "(DET"
exit exitrc

/* ******************* */
/*  Internal routines  */
/* ******************* */


/**********************************************************************/
AddFile:  procedure , /* Add a new file destination */
          expose fileforward. fileclasses. localnode loggedon.
parse arg destination classes logonstatus .
if logonstatus = 'ANYTIME'  then             /* Standardize value     */
   logonstatus = 'YES'
else
   logonstatus = 'NO'
allok = 1                                    /* No errors (yet)       */
if validdest('NJE')  then  do                /* Check address         */
   matches = filematch(destination classes)  /* Check for matches &   */
                                             /*   overlaps            */
   select
      when overlap.0 > 0  then  do           /* Found an overlap      */
         say 'The classes specified for' destination '('classes')' ,
            'overlap with the following other destination ids:'
         say ' '
         do i=1 for fileforward.0            /* Show the              */
            if overlap.i  then               /*   overlap lines       */
               say '  'left(fileforward.i,19) fileclasses.i
            end
         allok = 0                           /* Not ok                */
         end
      when matches = 0  then  do             /* Add a new dest        */
         last = fileforward.0 + 1            /* Pick the next spot    */
         fileforward.last = destination      /* Add into list         */
         fileclasses.last = classes
         loggedon.last    = logonstatus
         fileforward.0 = last                /* Update the count      */
         fileclasses.0 = last
         loggedon.0    = last
         end
      when matches = 1  then  do             /* Replace a dest        */
         do i=1 for fileforward.0
            if match.i  then  leave          /* Stop at match         */
            end
         fileforward.i = destination         /* Replace the entry     */
         fileclasses.i = classes
         loggedon.i    = logonstatus
         end
      otherwise  do
         say ' '
         say '*** ERROR *** File structure error in FORWARD file'
         say '"'destination'" exists more than once in the file'
         say 'This error must be corrected by hand before further' ,
             'processing can be done'
         say '*** ERROR ***'
         say ' '
         allok = 0                           /* Not ok                */
         end
      end
   end
else  do                                     /* Bad address           */
   say '"'destination'" is not valid: ' failure
   allok = 0
   end
return allok


/**********************************************************************/
AddMail:  procedure , /* Add a new mail destination */
          expose forward. localnode
parse arg destination .
allok = 1                                    /* No errors (yet)       */
if validdest()  then  do                     /* Check address         */
   if mailmatch(destination) = 0  then  do   /* Check for duplicate   */
      last = forward.0 + 1                   /* Pick the next spot    */
      forward.last = destination             /* Add into list         */
      forward.0 = last                       /* Update count          */
      end
   else                                      /* Duplicate address     */
      say '"'destination'" is a duplicate mail destination'
   end
else  do                                     /* Bad address           */
   say '"'destination'" is not valid: ' failure
   allok = 0
   end
return allok


/**********************************************************************/
DelFile:  procedure , /* Add a new file destination */
          expose fileforward. fileclasses. localnode loggedon.
parse arg destination .
allok = 1                                    /* No errors (yet)       */
if validdest('NJE')  then  do                /* Check address         */
   if filematch(destination) = 0  then       /* Check for exists      */
      say '"'destination'" is not a file forwarding destination'
   else  do                                  /* Destination exists    */
      j=0                                    /* Initialize counter    */
      do i=1 to fileforward.0                /* Do all lines          */
         if ^match.i  then  do               /* Keep this one         */
            j=j+1                            /* Increment line ctr    */
            if j<>i  then  do                /* If 1 or more dropped  */
               fileforward.j = fileforward.i /*   copy line forward   */
               fileclasses.j = fileclasses.i
               loggedon.j = loggedon.i
               end
            end
         end
      fileforward.0 = j                      /* Update line count     */
      fileclasses.0 = j
      loggedon.0    = j
      end
   end
else  do                                     /* Bad address           */
   say '"'destination'" is not valid: ' failure
   allok = 0
   end
return allok


/**********************************************************************/
DelMail:  procedure , /* Add a new mail destination */
          expose forward. localnode
parse arg destination .
allok = 1                                    /* No errors (yet)       */
if validdest()  then  do                     /* Check address         */
   if mailmatch(destination) = 0  then       /* Check for exists      */
      say '"'destination'" is not a mail forwarding destination'
   else  do                                  /* Destination exists    */
      j=0                                    /* Initialize counter    */
      do i=1 to forward.0                    /* Do all lines          */
         if ^match.i  then  do               /* Keep this one         */
            j=j+1                            /* Increment line ctr    */
            if j<>i  then                    /* If 1 or more dropped  */
               forward.j = forward.i         /*   copy line forward   */
            end
         end
      forward.0 = j                          /* Update line count     */
      end
   end
else  do                                     /* Bad address           */
   say '"'destination'" is not valid: ' failure
   allok = 0
   end
return allok


/**********************************************************************/
DoForward:  procedure , /* See if updates should occur */
            expose fileclasses. fileforward. forward. loggedon. ,
                   userid
reply = ''
say ' '
do until reply <> ''
   say ' '
   say 'Apply updates?'                      /* Ask the question      */
   parse upper pull reply .                  /* Get the response      */
   select
      when abbrev('LIST',reply,1)  then  do  /* LIST request          */
         call listforward
         reply = ''
         end
      when abbrev('QUIT',reply,1)  then      /* QUIT response         */
         reply = 0
      when abbrev('NO',reply,1)  then        /* NO response           */
         reply = 0
      when abbrev('YES',reply,1)  then       /* YES response          */
         reply = 1
      otherwise  do
         say 'Please respond with List, Yes, No or Quit'
         reply = ''
         end
      end
   end
return  reply


/**********************************************************************/
FileMatch:  procedure , /* Scan for matching destinations */
            expose fileforward. fileclasses. localnode loggedon. ,
                   match. overlap.
parse upper arg dest classes .
matches = 0                                  /* No matches yet        */
overlaps = 0                                 /* No overlaps yet       */

do i=1 for fileforward.0                     /* Scan all lines        */
   if translate(fileforward.i) = dest then do/* Have a match          */
      matches = matches + 1                  /* Update counter        */
      match.i = 1                            /* Update line flag      */
      overlap.i = 0                          /* By definition         */
      end
   else  do                                  /* Not a match           */
      match.i = 0                            /* Update line flag      */
      if overlap(classes,fileclasses.i)  then  do
         overlap.i = 1                       /* Remember overlap      */
         overlaps = overlaps + 1             /* Update count          */
         end
      else  overlap.i = 0                    /* Remember no overlap   */
      end
   end

overlap.0 = overlaps                         /* Set overlap count     */
return matches


/**********************************************************************/
FormatList:  procedure  /* Format a list of words into a comma        */
                        /*    separated string for a sentence         */
parse var wordlist
newlist = word(wordlist,1)                   /* Seed the list         */
totalwords = words(wordlist)
do i=2 to totalwords-1
   newlist = newlist',' word(wordlist,i)     /* Add on next word      */
   end
if totalwords > 1  then                      /* Add in the last word  */
   newlist = newlist 'and' word(wordlist,totalwords)
return newlist


/**********************************************************************/
GetLoc:  procedure   /* Get a disk address and mode */
parse arg diskmodes

do addr=x2d(111)                             /* Free address > 110    */
   parse value diagrc(8,'CP QUERY VIRTUAL' d2x(addr)) with ,
     rc +10 .
   if rc <> 0  then  do
      freeaddr = d2x(addr)
      leave
      end
   end

if diskmodes = ''  then
   diskmodes = 'G H I J K L M N O P Q R T U V W X Z B C D E F'
diskmodes = space(diskmodes,0)

freemode = ''
do while diskmodes <> ''
   parse var diskmodes diskmode +1 diskmodes
   'ESTATE * *' diskmode
   if rc = 36  then  do
      freemode = diskmode
      leave
      end
   end

return freeaddr freemode


/**********************************************************************/
GetOldInfo:  procedure , /* Initialize with any existing info */
             expose fileclasses. fileforward. forward. loggedon. ,
                    userid creationdate updatedate
parse upper arg mode .

fileclasses.0 = 0                            /* Initialize for safety */
fileforward.0 = 0
forward.0     = 0
loggedon.0    = 0

'ESTATE' userid 'FORWARD' mode               /* Any forwarding?       */
if rc <> 0  then  return                     /* No, all done          */

'EXECIO * DISKR' userid 'FORWARD' mode '(FINIS STEM LINE.'

mailfwds = 0                                 /* Set some counters     */
filefwds = 0
do i=1 to line.0                             /* Scan the file         */
   if left(word(line.i,1),1) <> '*'  then  do/* Found mail forward    */
      mailfwds = mailfwds + 1                /* Up the count          */
      forward.mailfwds = strip(line.i)       /* Save forwarding       */
      end
   else  do                                  /* Found a comment       */
      parse upper var line.i '*' type ':' .  /* Check line type       */
      if i=1 then  do
         if type = 'CREATED'  then           /* Have control line     */
            parse upper var line.i '*' . 'CREATED:' creationdate ,
               'UPDATED:' updatedate
         creationdate = space(creationdate)
         updatedate   = space(updatedate)
         end
      if type = 'FILES'  then  do            /* Found file forward    */
         filefwds = filefwds + 1             /* Up the count          */
         parse upper var line.i '*' . ':' ,  /* Get the values        */
            fileforward.filefwds . 'CLASSES:' fileclasses.filefwds . ,
            'LOGGEDON:' loggedon.filefwds .
         end
      end
   end

fileclasses.0 = filefwds                     /* Update the counts     */
fileforward.0 = filefwds
forward.0     = mailfwds
loggedon.0    = filefwds

return

/**********************************************************************/
Link: procedure  /* Link to disk */
parse upper arg linkparms
"CP LINK" linkparms                          /* Try standard link     */
if rc <> 0  then
   say 'Unable to link to' subword(linkparms,1,2)
return rc


/**********************************************************************/
ListForward:  procedure , /* List forwarding info */
              expose fileclasses. fileforward. forward. loggedon. ,
                     userid creationdate updatedate

say ' '                                      /* For pretty            */
if forward.0 = 0  then  do                   /* No forward exists     */
   say 'No forwarding is being done for' userid
   end
else  do                                     /* List mail fowardings  */
   msgline = 'Mail forwards:'
   sofar = length(msgline)
   do i=1 to forward.0
      if(sofar+length(forward.i)+2 > 80)  then do
         say msgline                         /* Write this line now   */
         msgline = left(' ',16) || forward.i /* Start a new line      */
         end
      else                                   /* Add on to this line   */
         msgline = msgline'  'forward.i
      end
   say msgline
   say ' '
   if fileforward.0 > 0  then  do            /* Have file forwards    */
      say 'File forwards:'
      say ' '
      say ,                                  /* Write headings        */
         center('transfer',21)'  'left(' ',38)'  'center('When to',12)
      say ,
         center('destination',21)'  ' || ,
         left(' classes to transfer',38)'  'center('transfer',12)
      say ,
         copies('=',21)'  'copies('=',38)'  'copies('=',12)
      do i=1 to fileforward.0                /* List file forwardings */
         if loggedon.i = 'YES'  then  striptime = ' Any time '
         else                         striptime = 'Logged off'
         say ,                               /* Write line            */
            center(fileforward.i,21)'  ' || ,
            center(left(fileclasses.i,36),38)'  'center(striptime,12)
         end
      end
   else  say 'No file forwarding is being done'
   end

say ' '                                      /* For pretty            */
return


/**********************************************************************/
Logit:  procedure ,  /* Place activity entry in log file */
        expose mode                          /*                       */
parse arg logline                            /*                       */
'EXECIO 1 DISKW FWDMAIL LOG' mode '(FINIS STRING' logline
say logline                                  /*                       */
return


/**********************************************************************/
MailMatch:  procedure , /* Scan for matching destinations */
            expose forward. match.
parse upper arg dest .
matches = 0                                  /* No matches yet        */

do i=1 for forward.0                         /* Scan all lines        */
   if translate(forward.i) = dest then do    /* Have a match          */
      matches = matches + 1                  /* Update counter        */
      match.i = 1                            /* Update line flag      */
      end
   else                                      /* Not a match           */
      match.i = 0                            /* Update line flag      */
   end

return matches


/**********************************************************************/
Overlap:  procedure  /* Check for class overlaps */
parse upper arg list1 , list2
if list1 = '' | list2 = ''  then  return 0   /* By definition         */
if list1 = '*'  then  return 1               /* By definition         */
if list2 = '*'  then  return 1               /* By definition         */

list1 = strip(list1)                         /* Get rid of pesky      */
list2 = strip(list2)                         /*     blanks            */

do i=1 to length(list1)                      /* Scan all characters   */
   if pos(substr(list1,i,1),list2) > 0  then  return 1
   end

return 0                                     /* No match              */


/**********************************************************************/
SendCmds:  procedure ,  /* Issue commands to mailer to make changes   */
         expose delete delfiles delfilesdest. delmail delmaildest. ,
                filedel filefwd maildel mailerid mailfwd newfiles ,
                newfilesclass. newfilesdest. newfileslogon. ,
                newmail newmaildest. userid

if userid <> userid()  then                  /* Need FOR value       */
   for = 'FOR' userid
else                                         /* No FOR value         */
   for = ''

if delete  then                              /* Do total delete       */
   'EXEC TELL' mailerid 'FORWARD' for 'DELETE ALL'

if mailfwd  then  do                         /* Mail forwards to add  */
   do i=1 for newmail
      'EXEC TELL' mailerid 'FORWARD' for 'MAIL ADD' newmaildest.i
      end
   end

if maildel  then  do                         /* Mail forwards to del. */
   do i=1 for delmail
      'EXEC TELL' mailerid 'FORWARD' for 'MAIL DELETE' delmaildest.i
      end
   end

if filedel  then  do                         /* File forwards to del. */
   do i=1 for delfiles
      'EXEC TELL' mailerid 'FORWARD' for 'FILES' delfilesdest.i ,
         'DELETE'
      end
   end

if filefwd  then  do                         /* File forwards to add  */
   do i=1 for newfiles
      'EXEC TELL' mailerid 'FORWARD' for 'FILES' newfilesdest.i ,
         'CLASS' newfilesclass.i newfileslogon.i
      end
   end


return


/**********************************************************************/
Update:  procedure , /* Run the update process locally */
         expose delete delfiles delfilesdest. delmail delmaildest. ,
                error fileclasses. filedel fileforward. filefwd ,
                force forward. localnode loggedon. maildel mailfwd ,
                newfiles newfilesclass. newfilesdest. newfileslogon. ,
                newmail newmaildest.

if mailfwd  then  do                         /* Mail forwards to add  */
   say 'Adding new mail forward(s)s'
   do i=1 for newmail
      if ^addmail(newmaildest.i) then        /* Add a new entry       */
         error = 1                           /* Had an error          */
      end
   end

if maildel  then  do                         /* Mail forwards to del. */
   say 'Deleting mail forward destination(s)'
   if forward.0 = 0  then  do                /* No forwards in place  */
      say 'No mail forwardings exist, all deletions will fail'
      error = 1                              /* This is not good      */
      end
   do i=1 for delmail
      if ^delmail(delmaildest.i) then        /* Delete an old entry   */
         error = 1                           /* Had an error          */
      end
   end

if filedel  then  do                         /* File forwards to del. */
   say 'Deleting file forward destination(s)'
   if fileforward.0 = 0  then  do            /* No forwards in place  */
      say 'No file forwardings exist, all deletions will fail'
      error = 1                              /* This is not good      */
      end
   do i=1 for delfiles
      if ^delfile(delfilesdest.i) then       /* Delete an old entry   */
         error = 1                           /* Had an error          */
      end
   end

if filefwd  then  do                         /* File forwards to add  */
   say 'Adding new file forward(s)s'
   do i=1 for newfiles
      if ^addfile(newfilesdest.i newfilesclass.i newfileslogon.i)  then
         error = 1                           /* Had an error          */
      end
   end

return


/* *****************************************************************  */
/*                                                                    */
/*  ValidDest will validate an address against RFC822 (I hope).       */
/*                                                                    */
/*  The address to be check is passed in the REXX variable            */
/*  'destination'.  This value may be changed during the validation   */
/*  process so that all addresses will be in a standard form.         */
/*                                                                    */
/*  If there is a problem with the address, the reason for the        */
/*  failure will be returned in the exposed variable 'failure'        */
/*                                                                    */
/* *****************************************************************  */

ValidDest:  procedure , /* Validate a destination address */
            expose destination failure localnode
parse upper arg type .                       /*                       */
if type = ''  then  type = 'RFC822'          /* Default type          */

workdest = strip(destination)                /*                       */

if workdest = '*'  then  do                  /* To user?              */
   destination = '<*>'                       /* Yes, kludge address   */
   return 1                                  /*                       */
   end

failure = ''                                 /*                       */
routeaddr = ''                               /*                       */
userid = ''                                  /*                       */
domain = ''                                  /*                       */
quoted.0 = 0                                 /*                       */

do while left(workdest,1) = '<'              /* Strip any hairpins    */
   if right(workdest,1) <> '>'  then  do     /*                       */
      failure = '"<" missing matching ">"'   /*                       */
      return 0                               /*                       */
      end
   else                                      /*                       */
      workdest = substr(workdest,2,length(workdest)-2)
   end

do i=1                                       /* Remove quoted strings */
   first = pos('"',workdest)                 /*                       */
   if first = 0  then  leave                 /*                       */
   second = pos('"',workdest,first+1)        /*                       */
   if second = 0  then  do                   /* Not matched           */
      failure = 'Missing ending quote on quoted string'
      return 0                               /*                       */
      end
   quoted.0 = i                              /*                       */
   quoted.i = substr(workdest,first+1,second-first-1)
   workdest = delstr(workdest,first,second-first+1) /* Delete quote   */
   workdest = insert(d2c(i),workdest,first-1)/* Insert flag           */
   end

/* May have an RFC733 address at this point.  The only problem is the */
/* use of ' AT ' for '@' in 733.  See if this is the case and convert */
/* to valid RFC822 form.                                              */

if words(workdest) = 3  then  do             /* Possible RFC733 format*/
   if translate(word(workdest,2)) = 'AT'  then  /* It is 733 format   */
      workdest = word(workdest,1)'@'word(workdest,3)
   end

/* Have <routeaddr:>userid<@node> at this point with quoted strings   */
/* hidden as unprintable values.                                      */

if pos(':',workdest) > 0  then               /*                       */
   parse var workdest routeaddr ':' userid '@' domain
else                                         /*                       */
   parse var workdest userid '@' domain

if routeaddr <> '' & domain = ''  then  do   /*                       */
   routeaddr = reverse(routeaddr)            /*                       */
   parse var routeaddr domain '@' routeaddr
   domain = reverse(domain)                  /*                       */
   if left(routeaddr,1) = ','  then
      routeaddr = substr(routeaddr,2)
   routeaddr = reverse(routeaddr)            /*                       */
   end

if type = 'NJE'  then  do                    /* Validate for NJE      */
   if routeaddr <> '' | ,                    /* Not allowed           */
      pos('.',domain) > 0  then  do          /* Only 1 token          */
      failure = 'Not a valid NJE address'
      return 0                               /*                       */
      end
   end

select                                       /*                       */
   when routeaddr = '' & domain = ''  then  do  /*                    */
      if type = 'NJE'  then                  /*                       */
         destination = '<'userid'@'localnode'>'
      else                                   /*                       */
         destination = '<'userid'>'
      end
   when routeaddr = '' & domain <> '' then  do  /*                    */
      upper domain                           /*                       */
      destination = '<'userid'@'domain'>'    /*                       */
      end
   otherwise  do                             /*                       */
      upper routeaddr domain                 /*                       */
      destination = '<'routeaddr':'userid'@'domain'>'
      end
   end                                       /*                       */

do i=1 to quoted.0                           /*                       */
   spot = pos(d2c(i),destination)            /*                       */
   destination = delstr(destination,spot,1)  /*                       */
   destination = insert('"'quoted.i'"',destination,spot-1)
   end

return 1

/* **************** */
/*  Error handlers  */
/* **************** */

ERROR:
parse source . . myname .
say "Error in" myname "line" sigl":"
say sourceline(sigl)
exitrc = rc
signal errexit

HALT:
parse source . . myname .
say "Halt in" myname "line" sigl":"
say sourceline(sigl)
exitrc = 16
signal errexit

NOVALUE:
parse source . . myname .
say "NOVALUE error in" myname "line" sigl":"
say sourceline(sigl)
exitrc = 16
signal errexit

SYNTAX:
parse source . . myname .
say "SYNTAX error in" myname "line" sigl": " errortext(rc)
say sourceline(sigl)
exitrc = 16
signal errexit

ERREXIT:
trace ?r
nop
exit exitrc
